def Xform "World"
{
    def "Materials"
    {
        def Material "floor"
        {
            token outputs:surface.connect = </World/Materials/floor/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.067, 0.076)
                float inputs:roughness = 0.43
                token outputs:surface
            }
        }

