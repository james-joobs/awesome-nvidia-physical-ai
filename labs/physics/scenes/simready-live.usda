    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </World/Materials/floor>
        double size = 1
        float3 xformOp:scale = (48, 48, 0.12)
        double3 xformOp:translate = (0, 0, -0.06)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Camera "FilmCamera"
    {
        float2 clippingRange = (0.025, 80)
        float focalLength = 38
        float horizontalAperture = 36
        float verticalAperture = 20.25
        matrix4d xformOp:transform = ( (1, 0, -0, 0), (0, 0.37440519388795207, 0.9272651998159561, 0), (0, -0.9272651998159561, 0.37440519388795207, 0), (0, -2.67, 2.05, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

