#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 0
    endTimeCode = 300
    timeCodesPerSecond = 60
    framesPerSecond = 60
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    variants = {
        string collider = "WithCollider"
    }
    prepend variantSets = "collider"
)
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.23, 0.28, 0.34)]
        double3 xformOp:translate = (0, 0, -0.1)
        float3 xformOp:scale = (12, 12, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "DropBody" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        double3 xformOp:translate = (0, 0, 3.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Cube"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.45, 0.8, 0.08)]
        }
    }

    def DistantLight "KeyLight"
    {
        float inputs:angle = 1
        float inputs:intensity = 1600
        float3 xformOp:rotateXYZ = (30, -25, -20)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "FillLight"
    {
        float inputs:intensity = 200
    }

    def Camera "LessonCamera"
    {
        float focalLength = 38
        float horizontalAperture = 36
        float verticalAperture = 20.25
        matrix4d xformOp:transform = (
            (0.808736084, 0.588171698, 0, 0),
            (-0.181033460, 0.248921008, 0.951454265, 0),
            (0.559618470, -0.769475397, 0.307790159, 0),
            (8, -11, 6, 1)
        )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    variantSet "collider" = {
        "WithoutCollider" {
        }
        "WithCollider" {
            over "DropBody"
            {
                over "Cube" (
                    prepend apiSchemas = ["PhysicsCollisionAPI"]
                )
                {
                }
            }
        }
    }
}
