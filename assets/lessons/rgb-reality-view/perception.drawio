<mxfile host="app.diagrams.net" type="device"><diagram id="perception-en" name="Perception EN"><mxGraphModel page="1" pageWidth="1140" pageHeight="474"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="RGB camera frames&#10;uint8[H,W,3]&#10;Real camera pixels only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="24" y="28" width="340" height="156" as="geometry" /></mxCell><mxCell id="3" value="Mask R-CNN on CUDA&#10;Class + score + bbox&#10;An instance mask per detection" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="404" y="28" width="340" height="156" as="geometry" /></mxCell><mxCell id="4" value="Actual 2D model outputs&#10;bbox [x0,y0,x1,y1]&#10;Mask → compressed binary raster" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="784" y="28" width="340" height="156" as="geometry" /></mxCell><mxCell id="5" value="RGB-derived scene geometry&#10;COLMAP K + pose + road plane&#10;No supplied depth or calibration" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="24" y="242" width="340" height="156" as="geometry" /></mxCell><mxCell id="6" value="Approximate ground contact&#10;Mask bottom pixel → camera ray&#10;Ray meets the estimated road plane" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="404" y="242" width="340" height="156" as="geometry" /></mxCell><mxCell id="7" value="Inspect the same observation&#10;2D masks on the original RGB&#10;3D markers in relative viewer units" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="784" y="242" width="340" height="156" as="geometry" /></mxCell><mxCell id="edge0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#669c00;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#669c00;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#669c00;" edge="1" parent="1" source="2" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#669c00;" edge="1" parent="1" source="4" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#669c00;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#669c00;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="perception-ko" name="Perception KO"><mxGraphModel page="1" pageWidth="1140" pageHeight="474"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="RGB 카메라 사진&#10;uint8[H,W,3]&#10;입력은 실제 카메라 픽셀" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="24" y="28" width="340" height="156" as="geometry" /></mxCell><mxCell id="3" value="CUDA에서 Mask R-CNN 추론&#10;종류 + 점수 + 검출 박스&#10;객체마다 픽셀 마스크 예측" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="404" y="28" width="340" height="156" as="geometry" /></mxCell><mxCell id="4" value="실제 모델의 2D 출력&#10;bbox [x0,y0,x1,y1]&#10;마스크 → 압축한 이진 배열" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="784" y="28" width="340" height="156" as="geometry" /></mxCell><mxCell id="5" value="RGB로 복원한 장면 정보&#10;COLMAP K + 자세 + 도로면&#10;외부 깊이·보정값 사용 안 함" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="24" y="242" width="340" height="156" as="geometry" /></mxCell><mxCell id="6" value="지면 접점 위치 추정&#10;마스크 아래 픽셀 → 카메라 광선&#10;추정한 도로면과 만나는 점" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="404" y="242" width="340" height="156" as="geometry" /></mxCell><mxCell id="7" value="같은 관측을 두 화면에서&#10;원본 RGB 위의 마스크·박스&#10;3D 상대 좌표 위의 위치 표시" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#76b900;fontColor=#202b33;fontSize=18;" vertex="1" parent="1"><mxGeometry x="784" y="242" width="340" height="156" as="geometry" /></mxCell><mxCell id="edge0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#669c00;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#669c00;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#669c00;" edge="1" parent="1" source="2" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#669c00;" edge="1" parent="1" source="4" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed