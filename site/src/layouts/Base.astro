---
import '@fontsource-variable/inter';
import '@fontsource-variable/roboto-mono/wght.css';
import '../styles/theme.css';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import ThemeSelect from '../components/ThemeSelect.astro';
import TopicMenu from '../components/TopicMenu.astro';
import { copy, languages, pageUrl, catalogs, repository, repositoryFile } from '../lib/catalog.mjs';
import { heroImage } from '../lib/assets.mjs';
import { showcaseCopy } from '../lib/showcase.mjs';
import { topicForPage } from '../lib/topics.mjs';

const { locale, page = '', title, description, socialImage = heroImage } = Astro.props;
const labels = copy[locale];
const brand = 'Awesome NVIDIA Physical AI';
const fullTitle = title ? `${title} · ${brand}` : brand;
const absolute = (path) => new URL(path, Astro.site);
const activeTopic = page.startsWith('topics/') || Boolean(topicForPage(page));
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${pageUrl('en')}favicon.svg`} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolute(pageUrl(locale, page))} />
    {languages.map((lang) => <link rel="alternate" hreflang={lang} href={absolute(pageUrl(lang, page))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(pageUrl('en', page))} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absolute(socialImage)} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        const key = 'physical-ai-theme';
        const root = document.documentElement;
        const device = window.matchMedia('(prefers-color-scheme: dark)');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        const updateColor = () => {
          const theme = root.dataset.theme;
          const dark = theme === 'dark' || (theme === 'system' && device.matches);
          themeColor.content = dark ? '#000000' : '#ffffff';
        };
        const apply = (theme) => {
          root.dataset.theme = theme === 'light' || theme === 'dark' ? theme : 'system';
          updateColor();
        };
        try { apply(localStorage.getItem(key)); } catch { apply('system'); }
        device.addEventListener('change', updateColor);
        document.addEventListener('DOMContentLoaded', () => {
          const select = document.querySelector('[data-theme-select]');
          select.value = root.dataset.theme;
          select.parentElement.hidden = false;
          select.addEventListener('change', () => {
            apply(select.value);
            try { localStorage.setItem(key, root.dataset.theme); } catch {}
          });
          window.addEventListener('storage', (event) => {
            if (event.key !== key && event.key !== null) return;
            apply(event.newValue);
            select.value = root.dataset.theme;
          });
        });
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{labels.skip}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href={pageUrl(locale)} class="brand" lang="en">
          <span class="brand-mark"><Icon name="cube" size={21} /></span>
          <span>Awesome <strong>NVIDIA Physical AI</strong></span>
        </a>
        <nav class="main-nav" aria-label={labels.navigation}>
          <TopicMenu locale={locale} page={page} activeTopic={activeTopic} />
          <a href={`${pageUrl(locale)}#workflows`}>{labels.workflows}</a>
          <a href={`${pageUrl(locale)}#onboarding`}>{locale === 'ko' ? '환경 설정' : 'Setup'}</a>
          <a href={pageUrl(locale, 'catalog')} aria-current={page === 'catalog' ? 'page' : undefined}>{labels.browseCatalog}</a>
        </nav>
        <div class="header-actions">
          <nav class="languages" aria-label={labels.language}>
            {languages.map((lang) => {
              const name = lang === 'en' ? 'English' : '한국어';
              return lang === locale
                ? <span lang={lang} aria-current="page" aria-label={name}>{name}</span>
                : <a href={pageUrl(lang, page)} lang={lang} hreflang={lang} aria-label={name} data-language-switch>{name}</a>;
            })}
          </nav>
          <ThemeSelect locale={locale} />
          <a class="header-github" href={repository} lang="en">GitHub <Icon name="external" size={16} /></a>
        </div>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div><span lang="en">{brand}</span><p>{labels.community}</p></div>
        <div class="footer-links">
          <a href={pageUrl(locale, 'showcase')}>{showcaseCopy[locale].nav}</a>
          <a href={`${pageUrl(locale)}#ecosystem`}>{labels.ecosystem}</a>
          <a href={`${pageUrl(locale)}#models`}>{labels.models}</a>
          <a href={repositoryFile(catalogs[locale].file)}>{labels.catalog} <Icon name="external" size={16} /></a>
          <a href={repositoryFile('NOTICE.md')}>{labels.license} <Icon name="external" size={16} /></a>
        </div>
      </div>
    </footer>
    <script>
      const switchLink = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
      if (switchLink) {
        const updateLanguageLink = () => {
          switchLink.hash = window.location.hash;
        };
        updateLanguageLink();
        window.addEventListener('hashchange', updateLanguageLink);
      }
      if (navigator.clipboard?.writeText) {
        for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-code]')) {
          const code = button.closest('.code-block')?.querySelector('pre code');
          const status = button.querySelector('span');
          if (!code || !status) continue;
          const label = status.textContent;
          let reset: number;
          button.hidden = false;
          button.addEventListener('click', async () => {
            clearTimeout(reset);
            try {
              await navigator.clipboard.writeText(code.textContent ?? '');
              status.textContent = button.dataset.copied ?? label;
            } catch {
              status.textContent = button.dataset.copyFailed ?? label;
            }
            reset = window.setTimeout(() => { status.textContent = label; }, 2400);
          });
        }
      }
    </script>
  </body>
</html>
