---
const { tags, label } = Astro.props;
---
<ul class="tool-tags" aria-label={label ?? undefined}>
  {tags.map((tag) => <li>{tag}</li>)}
</ul>
<style>
  .tool-tags {
    display: flex; flex-wrap: wrap; align-items: center; gap: .35rem;
    list-style: none; padding: 0; margin: 0;
  }
  li {
    padding: 2px 8px; border: 1px solid var(--field-edge); border-radius: 999px;
    color: var(--muted); font-size: .73rem; line-height: 1.4;
  }
</style>
