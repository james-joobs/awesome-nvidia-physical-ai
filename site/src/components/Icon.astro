---
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'cube' && <path d="M12 2.8 21 8v8l-9 5.2L3 16V8l9-5.2ZM3 8l9 5.2L21 8m-9 5.2v8" />}
  {name === 'workbench' && <path d="M3 7h18v4H3zM5 11v8m14-8v8M5 15h14m-9-8V4h4v3" />}
  {name === 'car' && <path d="m5 11 1.6-4.1A1.5 1.5 0 0 1 8 6h8a1.5 1.5 0 0 1 1.4.9L19 11M5 11h14a2 2 0 0 1 2 2v3H3v-3a2 2 0 0 1 2-2Zm1 5v2m12-2v2M6 13.5h1m10 0h1" />}
  {name === 'right' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'down' && <path d="M12 4v15m-6-6 6 6 6-6" />}
  {name === 'external' && <path d="M7 17 17 7M7 7h10v10" />}
  {name === 'download' && <path d="M12 3v12m-5-5 5 5 5-5M5 16v4h14v-4" />}
  {name === 'menu' && <path d="M4 6h16M4 12h16M4 18h16" />}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
  {name === 'robot' && <path d="M12 4v3m-7 5H3v5h2m14-5h2v5h-2M8 8h8a3 3 0 0 1 3 3v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a3 3 0 0 1 3-3Zm1 5v1m6-1v1" />}
  {name === 'layers' && <path d="m3 8 9-4 9 4-9 4-9-4Zm0 4 9 4 9-4M3 16l9 4 9-4" />}
  {name === 'terminal' && <path d="M4 5h16v14H4zM7 9l3 3-3 3m6 0h4" />}
  {name === 'file' && <path d="M6 3h8l4 4v14H6zM14 3v5h4m-9 5h6m-6 4h6" />}
  {name === 'database' && <path d="M19 6c0 1.7-3.1 3-7 3S5 7.7 5 6s3.1-3 7-3 7 1.3 7 3Zm0 0v12c0 1.7-3.1 3-7 3s-7-1.3-7-3V6m0 6c0 1.7 3.1 3 7 3s7-1.3 7-3" />}
  {name === 'search' && <path d="M16.5 10.5a6 6 0 1 1-12 0 6 6 0 0 1 12 0Zm-1.7 4.3 4.7 4.7" />}
  {name === 'monitor' && <path d="M3 4h18v13H3zM12 17v4m-4 0h8" />}
  {name === 'sun' && <path d="M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19m0-14-1.4 1.4M6.4 17.6 5 19" />}
  {name === 'moon' && <path d="M21 14a9 9 0 1 1-11-11 7 7 0 0 0 11 11Z" />}
</svg>
