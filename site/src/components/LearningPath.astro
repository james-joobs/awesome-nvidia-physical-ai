---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import LessonLanding from './LessonLanding.astro';
import LessonPreview from './LessonPreview.astro';
import { pageUrl, repositoryFile } from '../lib/catalog.mjs';
import { courses, courseRoute, learningCopy, lessonUrl } from '../lib/learning.mjs';
import { topicForPage, topicsCopy } from '../lib/topics.mjs';

const { locale, course } = Astro.props;
const { title, description, setup, result, scope } = course[locale];
const advanced = course.advanced?.[locale];
const labels = learningCopy[locale];
const labIndex = locale === 'ko' ? 'labs/README.ko.md' : 'labs/README.md';
const route = courseRoute(course.slug);
const topic = topicForPage(route);
const media = topic.entries[0];
const topicLabels = topicsCopy[locale];
const steps = course.lessons.map((lesson, index) => ({ id: `lesson-${index + 1}`, label: lesson[locale][0] }));
if (advanced) steps.push({ id: 'advanced-lab', label: labels.advanced });
---
<Base locale={locale} page={route} title={title} description={description}>
  <LessonLanding locale={locale} title={title} description={description} steps={steps} theme={course.theme}>
    <Fragment slot="breadcrumbs">
      <a class="breadcrumb" href={`${pageUrl(locale)}#workflows`}>{labels.paths}</a>
      <a class="breadcrumb" href={pageUrl(locale, `topics/${topic.slug}`)}>{topic[locale].title}</a>
    </Fragment>
    <Fragment slot="facts">
      <dl class="path-facts">
        <div><dt>{labels.setup}</dt><dd>{setup}</dd></div>
        <div><dt>{labels.result}</dt><dd>{result}</dd></div>
      </dl>
      {scope && <p class="path-scope">{scope}</p>}
    </Fragment>
    <Fragment slot="actions">
        <a class="button button-primary" href={lessonUrl(locale, course.lessons[0].route)}>
          {course.lessons[0][locale][0]} <Icon name="right" size={16} />
        </a>
        <a class="plain-link" href={repositoryFile(labIndex)}>{labels.code} <Icon name="external" size={16} /></a>
    </Fragment>
    <LessonPreview slot="preview" image={media.image} alt={media[locale].alt ?? media[locale].title}
      caption={topicLabels[media.credit ? 'officialMedia' : media.clip ? 'recording' : 'capturedMedia']}
      href={media.credit?.url} label={media.credit?.label} external />
    <div slot="navigation" class="hub-band">
      <nav class="shell hub-views path-switcher" aria-label={labels.paths}>
        {courses.map((item) => (
          <a href={pageUrl(locale, courseRoute(item.slug))} aria-current={item.slug === course.slug ? 'page' : undefined}>
            {item[locale].title}
          </a>
        ))}
      </nav>
    </div>
    <section class="path-lessons" aria-labelledby="lesson-list-title">
      <h2 id="lesson-list-title">{labels.lessons}</h2>
      <ol class="lesson-list">
        {course.lessons.map((lesson, index) => {
          const [name, check] = lesson[locale];
          return (
            <li id={`lesson-${index + 1}`}>
              <a href={lessonUrl(locale, lesson.route)} class="hub-entry lesson">
                <span class="lesson-name">
                  <strong>{name}</strong>
                  <span class="hub-summary">{check}</span>
                  <span class="lesson-mode">{labels.modes[lesson.mode]}</span>
                </span>
                <Icon name="right" size={19} />
              </a>
            </li>
          );
        })}
      </ol>
    </section>
    {advanced && (
      <aside class="advanced-lab" id="advanced-lab" aria-labelledby="advanced-lab-title">
        <h2 id="advanced-lab-title">{labels.advanced}</h2>
        <a class="plain-link" href={lessonUrl(locale, course.advanced.route)}>
          {advanced[0]} <Icon name="right" size={17} />
        </a>
        <p>{advanced[1]}</p>
      </aside>
    )}
  </LessonLanding>
</Base>

<style>
  .path-lessons { margin-bottom: 24px; }
  .path-lessons h2 { padding-bottom: 10px; border-bottom: 1px solid var(--edge); font-size: 1.45rem; line-height: 1.25; }
  .path-facts { border-block-start: 1px solid var(--edge); margin-block: 16px; font-size: .875rem; }
  .path-facts div { display: grid; grid-template-columns: minmax(6rem, .6fr) minmax(0, 2fr); gap: 8px 12px; padding-block: 9px; border-block-end: 1px solid var(--edge); }
  .path-facts dt { font-weight: 650; }
  .path-facts dd { margin: 0; color: var(--prose-text); line-height: 1.55; overflow-wrap: anywhere; }
  .path-scope { padding: 9px 12px; border-inline-start: 2px solid var(--info); background: var(--info-tint); color: var(--prose-text); font-size: .875rem; line-height: 1.6; }
  .path-switcher a { min-width: 0; overflow-wrap: anywhere; }
  .lesson-list { margin: 0; padding-inline-start: 1.65rem; }
  .lesson-list li { min-width: 0; padding-inline-start: 3px; border-bottom: 1px solid var(--edge); }
  .lesson-list li::marker { color: var(--accent); font-weight: 700; font-variant-numeric: tabular-nums; }
  .lesson-name { min-width: 0; }
  .lesson-mode { display: inline-block; margin-top: 7px; padding: 2px 8px; border: 1px solid var(--field-edge); border-radius: 999px; color: var(--muted); font-size: .73rem; line-height: 1.4; }
  .advanced-lab { padding: 12px 14px 15px; border-inline-start: 2px solid var(--brand-green); background: var(--accent-tint); }
  .advanced-lab h2 { font-size: 1.05rem; }
  .advanced-lab a { min-height: 44px; }
  .advanced-lab p { color: var(--prose-text); font-size: .9rem; line-height: 1.6; }
  :lang(ko) :is(.lesson-name, .path-facts dd, .path-scope, .advanced-lab, .path-switcher a) { word-break: keep-all; overflow-wrap: anywhere; }
  @media (max-width: 570px) {
    .path-facts div { grid-template-columns: minmax(0, 1fr); gap: 3px; }
    .path-switcher a { font-size: .875rem; }
  }
</style>
