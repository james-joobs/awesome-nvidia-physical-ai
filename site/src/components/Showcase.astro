---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import ShowcaseVideo from './ShowcaseVideo.astro';
import ToolTags from './ToolTags.astro';
import { pageUrl, repositoryFile } from '../lib/catalog.mjs';
import { findLab, heroTags, labCopy, scenes } from '../lib/labs.mjs';
import { clips, featured, grids, sceneLabels, showcaseCopy, showcaseMedia } from '../lib/showcase.mjs';

const { locale } = Astro.props;
const labels = showcaseCopy[locale];
const labLabels = labCopy[locale];
const labUrl = (id) => pageUrl(locale, `labs/${id}`);
const sections = [
  { id: 'by-topic', title: labels.grids, items: grids },
  { id: 'single-clips', title: labels.clips, items: clips },
];
---
<Base locale={locale} page="showcase" title={labels.title} description={labels.intro}
  socialImage={showcaseMedia(`${featured.id}.jpg`)}>
  <header class="shell showcase-header" aria-labelledby="showcase-title">
    <h1 id="showcase-title">{labels.title}</h1>
    <p>{labels.intro}</p>
  </header>
  <div class="hub-band">
    <nav class="shell hub-views showcase-views" aria-label={labels.nav}>
      <a href="#featured" aria-current="location">{labels.overview}</a>
      {sections.map(({ id, title }) => <a href={`#${id}`}>{title}</a>)}
    </nav>
  </div>
  <section class="shell featured" id="featured" aria-labelledby="featured-title" data-video-section>
    <div class="feature-title">
      <h2 id="featured-title">{labels.featured}</h2>
      <a class="plain-link" href={showcaseMedia(`${featured.id}.mp4`)}>{labels.open} <Icon name="external" size={16} /></a>
    </div>
    <div class="feature-layout">
      <div class="hero-video">
        <ShowcaseVideo locale={locale} clip={featured} title={labels.featured} eager autoplay />
      </div>
      <div class="feature-context">
        <p>{labels.featuredDetail}</p>
        <ToolTags tags={heroTags} label={labLabels.tools} />
        <a class="plain-link" href="#by-topic">{labLabels.action} <Icon name="down" size={16} /></a>
      </div>
    </div>
    <details class="scene-list">
      <summary>{labels.scenes}<Icon name="chevron" size={16} /></summary>
      <ol>{sceneLabels[locale].map((scene, index) => {
        const [labId, tags] = scenes[index];
        return <li><a href={labUrl(labId)}>{scene}</a><ToolTags tags={tags} /></li>;
      })}</ol>
      <p>{labels.editNote}</p>
    </details>
  </section>
  {sections.map(({ id, title, items }) => (
    <section class="shell showcase-section" id={id} aria-labelledby={`${id}-heading`} data-video-section>
      <h2 id={`${id}-heading`}>{title}</h2>
      <div class="hub-media-grid showcase-grid">
        {items.map((item) => {
          const entry = item[locale];
          const lab = findLab(item.id);
          const guide = item.route ? pageUrl(locale, item.route) : repositoryFile(`docs/${locale}/${item.guide}.md`);
          return (
            <article class="hub-media-card showcase-card" id={item.id}>
              <ShowcaseVideo locale={locale} clip={item} title={entry.title} />
              <div class="showcase-caption">
                <h3>{entry.title}</h3>
                <p>{entry.description}</p>
                <ToolTags tags={lab.tags} label={labLabels.tools} />
                <div class="card-links">
                  <a class="plain-link lab-link" href={labUrl(lab.id)}>{labLabels.action} <Icon name="right" size={16} /></a>
                  <a class="plain-link" href={guide}>{labels.guide}</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  ))}
  <div class="shell credits">
    <a href={repositoryFile(locale === 'ko' ? 'labs/README.ko.md' : 'labs/README.md')}
      class="plain-link">{labLabels.index} <Icon name="external" size={16} /></a>
    <a href={repositoryFile('NOTICE.md')} class="plain-link">{labels.source} <Icon name="external" size={16} /></a>
  </div>
</Base>

<script>
  const views = document.querySelectorAll<HTMLAnchorElement>('.showcase-views a');
  const updateView = () => {
    const target = document.getElementById(window.location.hash.slice(1));
    const current = target?.closest<HTMLElement>('[data-video-section]')?.id ?? 'featured';
    for (const link of views) {
      if (link.hash === `#${current}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };
  updateView();
  window.addEventListener('hashchange', updateView);
</script>

<style>
  .showcase-header { padding-block: clamp(28px, 4vw, 55px) 26px; }
  .showcase-header h1 { font-size: clamp(1.875rem, 4vw, 2.5rem); line-height: 1.2; }
  .showcase-header p { margin-top: 12px; max-width: 46rem; color: var(--prose-text); line-height: 1.75; }
  .showcase-views a { min-width: 0; overflow-wrap: anywhere; }
  .featured, .showcase-section { padding-block-start: clamp(26px, 5vw, 58px); }
  .feature-title, .showcase-section > h2 { margin-bottom: 18px; padding-bottom: 8px; border-bottom: 1px solid var(--edge); }
  .feature-title { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 16px; }
  .feature-title h2, .showcase-section > h2 { font-size: 1.45rem; line-height: 1.25; }
  .feature-title a { min-height: 44px; }
  .feature-layout { display: grid; grid-template-columns: minmax(0, 3.4fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .hero-video { min-width: 0; overflow: clip; border: 1px solid var(--edge); border-radius: 8px; }
  .feature-context { min-width: 0; padding-inline-start: 14px; border-inline-start: 2px solid var(--edge); }
  .feature-context p { margin-bottom: 12px; color: var(--prose-text); line-height: 1.65; }
  .feature-context a { min-height: 44px; margin-top: 7px; }
  .scene-list { margin-top: 18px; border-block: 1px solid var(--edge); }
  .scene-list summary {
    display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 46px;
    cursor: pointer; list-style: none; font-size: .9375rem; font-weight: 650;
  }
  .scene-list summary:hover { color: var(--accent); }
  .scene-list summary::-webkit-details-marker { display: none; }
  .scene-list summary :global(svg) { flex: none; color: var(--accent); }
  .scene-list[open] summary :global(svg) { rotate: 180deg; }
  .scene-list ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 35px; margin: 3px 0 10px; padding-inline-start: 1.65rem; }
  .scene-list ol > li { min-width: 0; padding-block: 0 10px; border-top: 1px solid var(--edge); font-size: .9rem; }
  .scene-list ol > li::marker { color: var(--accent); font-weight: 700; font-variant-numeric: tabular-nums; }
  .scene-list ol > li > a { display: inline-flex; align-items: center; min-height: 44px; line-height: 1.45; text-decoration-color: var(--brand-green); text-underline-offset: 3px; }
  .scene-list ol > li > a:hover { color: var(--accent); }
  .scene-list p { padding-bottom: 12px; color: var(--muted); font-size: .875rem; line-height: 1.6; }
  .showcase-card > :global(.video-frame) { border-bottom: 1px solid var(--edge); }
  .showcase-caption { flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; padding: 16px 18px 12px; }
  .showcase-caption h3 { font-size: clamp(1.1rem, 2vw, 1.28rem); line-height: 1.35; }
  .showcase-caption p { color: var(--prose-text); font-size: .9375rem; line-height: 1.6; }
  .card-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0 14px; margin-top: auto; }
  .card-links a { min-height: 44px; }
  .card-links a:not(.lab-link) { color: var(--muted); }
  .credits { display: flex; flex-wrap: wrap; gap: 0 1rem; padding-block: 22px 30px; }
  :lang(ko) :is(.showcase-header p, .feature-context, .showcase-caption, .scene-list, .showcase-views a) { word-break: keep-all; overflow-wrap: anywhere; }
  @media (max-width: 900px) {
    .feature-layout { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .feature-context { padding: 0; border: 0; }
  }
  @media (max-width: 575px) {
    .showcase-views a { font-size: .875rem; }
    .scene-list ol { grid-template-columns: minmax(0, 1fr); }
    .showcase-caption { padding-inline: 14px; }
  }
</style>
