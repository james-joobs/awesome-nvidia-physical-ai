---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import RepoTour from './RepoTour.astro';
import ShowcaseVideo from './ShowcaseVideo.astro';
import { maps } from '../lib/assets.mjs';
import { copy, modelGuide, pageUrl, repositoryFile } from '../lib/catalog.mjs';
import { homeCopy } from '../lib/home.mjs';
import { courses, courseRoute, firstExerciseRoute, learningCopy, lessonUrl, onboardingGuides, workbenchRecordingRoute } from '../lib/learning.mjs';
import { principleGuideCount, principlesCopy, principlesRoute } from '../lib/principles.mjs';
import { clips, featured } from '../lib/showcase.mjs';
import { focusTopics, topicForPage, topics, topicsCopy } from '../lib/topics.mjs';

const { locale } = Astro.props;
const labels = copy[locale];
const home = homeCopy[locale];
const learning = learningCopy[locale];
const principles = principlesCopy[locale];
const theoryUrl = pageUrl(locale, principlesRoute);
const map = maps[locale];
const demo = clips.find(({ id }) => id === 'gr00t-placement');
const browserLab = lessonUrl(locale, firstExerciseRoute);
const firstPath = courses.find(({ slug }) => slug === 'simulation-data');
const labIndex = locale === 'ko' ? 'labs/README.ko.md' : 'labs/README.md';
const materials = [
  { title: home.codeTitle, description: home.codeDescription, icon: 'file', url: repositoryFile(labIndex), linkIcon: 'external' },
  { title: home.dataTitle, description: home.dataDescription, icon: 'database', url: lessonUrl(locale, workbenchRecordingRoute), linkIcon: 'right' },
];
const showcase = pageUrl(locale, 'showcase');
---
<Base locale={locale} description={home.description}>
  <div class="hero-band">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-audience">{learning.audience}</p>
        <h1 id="hero-title">{labels.heroTitle}<br /><em>{labels.heroAccent}</em></h1>
        <p class="hero-description">{home.description}</p>
        <div class="hero-actions">
          <a href={browserLab} class="button button-primary">{learning.firstExercise}<Icon name="right" size={18} /></a>
          <a href="#focus-areas" class="button button-secondary">{home.focusAction}<Icon name="down" size={17} /></a>
        </div>
        <div class="hero-links">
          <a href={theoryUrl} class="plain-link">{principles.all(principleGuideCount)}<Icon name="right" size={17} /></a>
          <a href={pageUrl(locale, 'tour')} class="plain-link">{home.siteTour}<Icon name="right" size={17} /></a>
        </div>
      </div>
      <figure class="home-video">
        <ShowcaseVideo locale={locale} clip={demo} title={demo[locale].title} eager />
        <figcaption>
          <a href={browserLab}>{demo[locale].title}</a>
          <span>Isaac Sim GUI · RTX 5090</span>
        </figcaption>
      </figure>
    </section>
    <nav class="shell journey" aria-label={home.journey}>
      <ol role="list">
        {firstPath.lessons.map((lesson, index) => {
          const [title, description] = home.stages[lesson.mode] ?? lesson[locale];
          return (
            <li>
              <a href={lessonUrl(locale, lesson.route)}>
                <span class="stage-number" aria-hidden="true">{index + 1}</span>
                <span class="stage-copy"><strong>{title}</strong><span>{description}</span></span>
                <Icon name="right" size={17} />
              </a>
            </li>
          );
        })}
      </ol>
    </nav>
  </div>

  <section class="shell landing-section focus-section" id="focus-areas" aria-labelledby="focus-heading">
    <div class="section-head landing-heading">
      <div><h2 id="focus-heading">{home.focusTitle}</h2><p>{home.focusIntro}</p></div>
      <a class="plain-link" href={showcase + '#four-domain-grid'}>{locale === 'ko' ? '네 분야 실행 영상' : 'Watch four fields in action'}</a>
    </div>
    <div class="path-grid focus-grid">
      {focusTopics.map((topic) => {
        const entry = topic.focus[locale];
        const preview = topic.entries[0];
        const url = pageUrl(locale, 'topics/' + topic.slug);
        return (
          <article class:list={['path-card', 'focus-card', topic.theme]}>
            <a class="path-cover" href={url} tabindex="-1" aria-hidden="true">
              <img src={preview.image} alt="" loading="lazy" decoding="async" class:list={{ 'focus-logo': preview.fit === 'contain' }} width="640" height="360" />
            </a>
            <div class="path-copy">
              <h3><a href={url}>{entry.title}</a></h3>
              <p>{entry.outcome}</p>
              <ul class="focus-stacks" role="list" aria-label={topicsCopy[locale].tools}>
                {topic.stacks.slice(0, 3).map((stack) => <li>{stack}</li>)}
              </ul>
              <p class="focus-availability">{entry.availability}</p>
              <a class="path-action" href={url} aria-label={home.focusOpen + ' · ' + entry.title}>{home.focusOpen}</a>
            </div>
          </article>
        );
      })}
    </div>
    <a class="plain-link focus-more" href={pageUrl(locale, 'topics/synthetic-data')}>{home.focusMore}</a>
  </section>

  <section class="shell landing-section" id="workflows" aria-labelledby="workflows-heading">
    <div class="section-head landing-heading">
      <div><h2 id="workflows-heading">{home.pathsTitle}</h2><p>{home.pathsIntro}</p></div>
      <a href={theoryUrl} class="plain-link">{principles.nav}<Icon name="right" size={17} /></a>
    </div>
    <div class="path-grid">
      {courses.map((course) => {
        const route = courseRoute(course.slug);
        const topic = topicForPage(route);
        const preview = topic.entries.find(({ id }) => id === 'robot-motion') ?? topic.entries[0];
        const entry = course[locale];
        const url = pageUrl(locale, route);
        return (
          <article class:list={['path-card', course.theme]}>
            <div class="path-cover">
              <img src={preview.image} alt={preview[locale].alt ?? preview[locale].title} loading="lazy" decoding="async" />
            </div>
            <div class="path-copy">
              <p class="path-mode">{home.pathModes[course.slug]}</p>
              <h3><a href={url}>{entry.title}</a></h3>
              <p>{entry.description}</p>
              <dl><dt>{learning.result}</dt><dd>{entry.result}</dd></dl>
              <a class="path-action" href={url} aria-label={learning.openPath + ' · ' + entry.title}>{learning.openPath}<Icon name="right" size={18} /></a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="home-discovery" id="topics" aria-labelledby="topics-heading">
    <div class="hub-band">
      <div class="shell">
        <div class="section-head discovery-heading">
          <div><h2 id="topics-heading">{home.exploreTitle}</h2><p>{home.exploreIntro}</p></div>
        </div>
        <nav class="hub-views" aria-label={home.exploreTitle}>
          <a href="#topics" aria-current="location">{topicsCopy[locale].nav}</a>
          <a href={theoryUrl}>{principles.nav}</a>
        </nav>
      </div>
    </div>
    <div class="shell discovery-grid">
      <ul class="topic-list" role="list">
        {topics.map((topic) => (
          <li>
            <a class="hub-entry" href={pageUrl(locale, 'topics/' + topic.slug)}>
              <span class="topic-copy">
                <strong>{topic[locale].title}</strong>
                <span class="hub-summary">{topic[locale].description}</span>
                <span class="topic-tags">{topic.stacks.slice(0, 3).map((stack) => <span>{stack}</span>)}</span>
              </span>
              <Icon name="right" size={17} />
            </a>
          </li>
        ))}
      </ul>
      <figure class="home-video discovery-video">
        <ShowcaseVideo locale={locale} clip={featured} title={learning.galleryTitle} />
        <figcaption>
          <a href={showcase}>{learning.galleryLink}<Icon name="right" size={16} /></a>
          <span>{locale === 'ko' ? '16개 장면' : '16 Isaac Sim scenes'}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="shell landing-section" id="onboarding" aria-labelledby="onboarding-heading">
    <div class="section-head landing-heading">
      <div><h2 id="onboarding-heading">{home.prepareTitle}</h2><p>{home.prepareIntro}</p></div>
    </div>
    <div class="resource-columns">
      <div class="resource-group">
        <h3>{home.setupHeading}</h3>
        <ul class="resource-list" role="list">
          {onboardingGuides.map((guide, index) => (
            <li>
              <a href={pageUrl(locale, guide.page)}>
                <Icon name={index === 0 ? 'terminal' : 'cube'} size={22} />
                <span><strong>{guide[locale].title}</strong><span>{guide[locale].description}</span></span>
                <Icon name="right" size={17} />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="resource-group">
        <h3>{home.materialsHeading}</h3>
        <ul class="resource-list" role="list">
          {materials.map((item) => (
            <li>
              <a href={item.url}>
                <Icon name={item.icon} size={22} />
                <span><strong>{item.title}</strong><span>{item.description}</span></span>
                <Icon name={item.linkIcon} size={17} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="landing-band reference-band" id="ecosystem" aria-labelledby="ecosystem-heading">
    <div class="shell landing-section reference-inner">
      <div class="section-head landing-heading">
        <div><h2 id="ecosystem-heading">{home.referenceTitle}</h2><p>{home.referenceIntro}</p></div>
      </div>

      <ul class="reference-links resource-list" role="list">
        <li>
          <a href={pageUrl(locale, 'catalog')}>
            <Icon name="search" size={22} />
            <span><strong>{labels.browseCatalog}</strong><span>{home.catalogDescription}</span></span>
            <Icon name="right" size={17} />
          </a>
        </li>
        <li id="models">
          <a href={pageUrl(locale, modelGuide.route) + '#comparison-table'}>
            <Icon name="robot" size={22} />
            <span><strong>{labels.modelsHeading}</strong><span>{home.modelDescription}</span></span>
            <Icon name="right" size={17} />
          </a>
        </li>
      </ul>
      <details class="map-preview">
        <summary><Icon name="layers" size={22} />{labels.ecosystem}<Icon name="chevron" size={18} /></summary>
        <div>
          <p>{labels.ecosystemDescription}</p>
          <a class="plain-link" href={map.wide}>{labels.openMap}<Icon name="external" size={16} /></a>
          <picture>
            <source media="(max-width: 715px)" srcset={map.mobile} width="387" height="1125" />
            <img src={map.wide} alt={labels.mapAlt} loading="lazy" decoding="async" width="1063" height="696" />
          </picture>
        </div>
      </details>
    </div>
    <RepoTour locale={locale} />
  </section>
</Base>

<script>
  const map = document.querySelector<HTMLDetailsElement>('.map-preview');
  const showLinkedMap = () => {
    if (map && window.location.hash === '#ecosystem') map.open = true;
  };
  showLinkedMap();
  window.addEventListener('hashchange', showLinkedMap);
</script>

<style>
  .hero-band {
    padding-block: clamp(32px, 5vw, 68px) 24px;
    background: var(--bg);
    border-bottom: 1px solid var(--edge);
  }
  .hero { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); gap: clamp(24px, 4vw, 68px); align-items: center; }
  .hero-audience { margin-bottom: 15px; color: var(--accent); font-size: .86rem; font-weight: 650; }
  .hero h1 { font-size: clamp(2.5rem, 5.2vw, 4.5rem); line-height: 1.03; letter-spacing: -.055em; text-wrap: pretty; }
  .hero h1 em { color: var(--accent); font-style: normal; }
  :lang(ko) .hero h1 { letter-spacing: -.042em; }
  .hero-description { max-width: 49ch; margin-block: 16px 22px; color: var(--prose-text); font-size: 1rem; line-height: 1.75; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 0 18px; margin-top: 4px; }
  .hero-links a { min-height: 44px; }
  .hero-actions :global(svg) { flex: none; }
  .button-secondary { border: 1px solid var(--edge); background: var(--surface); }
  .button-secondary:hover { border-color: var(--accent); }
  .home-video { min-width: 0; margin: 0; border: 1px solid var(--edge); border-radius: 12px; overflow: hidden; background: var(--surface); }
  .home-video figcaption { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0 12px; min-height: 44px; padding: 0 13px; font-size: .82rem; }
  .home-video figcaption a { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; font-weight: 650; text-underline-offset: 3px; }
  .home-video figcaption a:hover { color: var(--accent); }
  .home-video figcaption span { color: var(--muted); }

  .journey { margin-top: clamp(26px, 4vw, 50px); }
  .journey ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0; margin: 0; list-style: none; border-block: 1px solid var(--edge); }
  .journey li + li { border-inline-start: 1px solid var(--edge); }
  .journey a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 11px; height: 100%; padding: 12px 14px; text-decoration: none; }
  .journey a:hover { background: var(--surface-hover); }
  .stage-number { display: grid; place-items: center; width: 29px; height: 29px; border: 1px solid var(--edge); border-radius: 50%; color: var(--accent); font-family: var(--display); font-size: .84rem; font-weight: 700; }
  .stage-copy { display: grid; gap: 3px; }
  .stage-copy strong { font-size: .93rem; }
  .stage-copy > span { color: var(--muted); font-size: .8rem; line-height: 1.42; }
  .journey :global(svg) { color: var(--accent); }

  .landing-section { padding-block: clamp(36px, 5vw, 70px); }
  .landing-heading { margin-bottom: clamp(20px, 3vw, 30px); }
  .landing-heading h2 { font-size: clamp(1.75rem, 3.35vw, 2.83rem); }
  .landing-heading p { max-width: 76ch; margin-top: 8px; }
  .landing-band { background: var(--surface); border-block: 1px solid var(--edge); }

  .path-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 2vw, 22px); }
  .path-card { display: flex; flex-direction: column; min-width: 0; overflow: clip; border: 1px solid var(--edge); border-radius: 12px; background: var(--surface); }
  .path-card:is(:hover, :focus-within) { border-color: var(--route-color); }
  .path-cover { border-bottom: 1px solid var(--edge); background: var(--media-bg); }
  .path-cover img { width: 100%; aspect-ratio: 2 / 1; object-fit: cover; }
  .path-copy { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 16px 17px 4px; }
  .path-copy > p { color: var(--muted); font-size: .91rem; line-height: 1.52; }
  .path-copy .path-mode { color: var(--route-color); font-size: .77rem; font-weight: 650; }
  .path-copy h3 { font-size: clamp(1.18rem, 2.1vw, 1.5rem); line-height: 1.22; text-wrap: pretty; }
  .path-copy h3 a { text-decoration: none; }
  .path-copy h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .path-copy dl { margin: auto 0 0; padding-block: 8px 7px; font-size: .82rem; line-height: 1.45; }
  .path-copy dt { color: var(--muted); margin-bottom: 2px; }
  .path-copy dd { margin: 0; }
  .path-action { display: flex; align-items: center; justify-content: space-between; gap: 6px; width: 100%; min-height: 44px; border-top: 1px solid var(--edge); color: var(--route-color); font-size: .87rem; font-weight: 650; text-decoration: none; }
  .path-action:hover { text-decoration: underline; text-underline-offset: 3px; }
  .focus-section { padding-bottom: 0; }
  .focus-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .focus-card .path-cover img { aspect-ratio: 16 / 9; }
  .focus-card .path-cover .focus-logo { object-fit: contain; padding: 20px; background: #fff; }
  .focus-card .path-copy { gap: 12px; }
  .focus-card h3 { font-size: 1.28rem; }
  .focus-card .path-copy > p { font-size: .94rem; }
  .focus-stacks { display: flex; flex-wrap: wrap; gap: 5px; margin: 0; padding: 0; list-style: none; }
  .focus-stacks li { padding: 3px 7px; border: 1px solid var(--field-edge); border-radius: 4px; color: var(--prose-text); font-size: .875rem; line-height: 1.4; }
  .focus-card .path-copy .focus-availability { margin-top: auto; padding-block: 3px; color: var(--muted); font-size: .875rem; }
  .focus-more { margin-top: 12px; min-height: 44px; }

  .discovery-heading { padding-block: clamp(20px, 4vw, 35px) 0; margin-bottom: 14px; }
  .discovery-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(18px, 5vw, 64px); align-items: start; padding-block: clamp(22px, 4vw, 42px); }
  .topic-list, .resource-list { margin: 0; padding: 0; list-style: none; }
  .topic-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; border-top: 1px solid var(--edge); }
  .topic-list li { border-bottom: 1px solid var(--edge); }
  .topic-copy { min-width: 0; }
  .topic-tags { display: flex; flex-wrap: wrap; gap: 4px 7px; margin-top: 8px; }
  .topic-tags span { padding: 2px 8px; border: 1px solid var(--field-edge); border-radius: 999px; color: var(--muted); font-size: .73rem; line-height: 1.4; }
  .resource-list a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 11px 10px; min-height: 58px; text-decoration: none; }
  .resource-list a:hover { background: var(--surface-hover); }
  .resource-list a > span { min-width: 0; }
  .resource-list strong { display: block; line-height: 1.36; }
  .resource-list strong + span { display: block; margin-top: 4px; color: var(--muted); font-size: .83rem; line-height: 1.45; }
  .resource-list a > :global(svg) { color: var(--accent); }

  .resource-columns, .reference-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
  .resource-group, .reference-links li { min-width: 0; border: 1px solid var(--edge); border-radius: 10px; background: var(--surface); }
  .resource-group h3 { margin: 0 16px; padding-block: 13px 10px; border-bottom: 1px solid var(--edge); font-size: 1.08rem; }
  .resource-group .resource-list { padding: 4px 6px 6px; }
  .resource-group .resource-list li + li { border-top: 1px solid var(--edge); }
  .reference-band { border-bottom: 0; }
  .reference-inner { padding-bottom: 25px; }
  .reference-links a { height: 100%; padding: 13px 16px; border-radius: inherit; }
  .map-preview { margin-top: 12px; border: 1px solid var(--edge); border-radius: 10px; background: var(--surface); }
  .map-preview summary { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 9px 16px; cursor: pointer; list-style: none; font-weight: 650; }
  .map-preview summary:hover, .map-preview summary :global(svg) { color: var(--accent); }
  .map-preview summary::-webkit-details-marker { display: none; }
  .map-preview summary :global(svg:last-child) { margin-inline-start: auto; }
  .map-preview[open] summary :global(svg:last-child) { rotate: 180deg; }
  .map-preview > div { padding: 0 16px 16px; }
  .map-preview p { color: var(--muted); line-height: 1.55; }
  .map-preview img { margin-inline: auto; max-height: 720px; object-fit: contain; }
  :lang(ko) :is(.hero-description, .stage-copy, .landing-heading p, .path-copy, .resource-list, .map-preview p) {
    word-break: keep-all; overflow-wrap: anywhere;
  }

  @media (max-width: 980px) {
    .focus-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .discovery-grid { grid-template-columns: minmax(0, 1fr) minmax(0, .92fr); }
    .topic-list { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 870px) {
    .hero { gap: 22px; }
    .path-cover img { aspect-ratio: 16 / 9; }
    .path-copy { padding-inline: 12px; }
    .resource-columns, .reference-links { gap: 9px; }
  }
  @media (max-width: 715px) {
    .hero, .journey ol, .path-grid, .focus-grid, .discovery-grid, .resource-columns, .reference-links { grid-template-columns: 1fr; }
    .hero h1 { font-size: clamp(2.18rem, 8.5vw, 3.7rem); }
    .hero-description { margin-block: 13px 17px; }
    .journey li + li { border-inline-start: 0; border-top: 1px solid var(--edge); }
    .journey a { padding-inline: 6px; }
    .home-video figcaption span { padding-block-end: 3px; }
    .path-copy { padding-inline: 14px; }
    .map-preview img { max-height: none; }
  }
</style>
