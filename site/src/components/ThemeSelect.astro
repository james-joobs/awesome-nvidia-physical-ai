---
import Icon from './Icon.astro';

const { locale } = Astro.props;
const ko = locale === 'ko';
const label = ko ? '화면 테마' : 'Appearance';
---
<label class="theme-select" title={label} hidden>
  <span class="system-icon"><Icon name="monitor" size={17} /></span>
  <span class="light-icon"><Icon name="sun" size={17} /></span>
  <span class="dark-icon"><Icon name="moon" size={17} /></span>
  <select data-theme-select aria-label={label}>
    <option value="system">{ko ? '시스템 설정' : 'System'}</option>
    <option value="light">{ko ? '라이트' : 'Light'}</option>
    <option value="dark">{ko ? '다크' : 'Dark'}</option>
  </select>
</label>

<style>
  .theme-select {
    position: relative; display: grid; place-items: center; flex: none; width: 44px; height: 44px;
    border-radius: 8px; color: var(--muted);
  }
  .theme-select[hidden] { display: none; }
  .theme-select:is(:hover, :focus-within) { background: var(--accent-tint); color: var(--accent); }
  .theme-select:focus-within { outline: 2px solid var(--accent); }
  .theme-select span { display: none; }
  :global(html[data-theme="light"]) .light-icon,
  :global(html[data-theme="dark"]) .dark-icon,
  :global(html[data-theme="system"]) .system-icon { display: flex; }
  select { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
</style>
