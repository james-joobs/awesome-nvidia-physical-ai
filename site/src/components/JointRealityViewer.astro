---
import {showcaseMedia} from '../lib/showcase.mjs';
const {locale}=Astro.props;const ko=locale==='ko';
---
<section id="joint-geometry" class="joint-viewer" data-joint-viewer data-locale={locale} data-joint-root={showcaseMedia('reality-joint-geometry')} aria-labelledby={`joint-title-${locale}`}>
  <h2 id={`joint-title-${locale}`}>{ko?'실사 도로를 3D로 둘러보기':'Explore a real road in 3D'}</h2>
  <p>{ko?'카메라 RGB로 복원한 도로에서 시점과 시간을 바꿔 보세요. 배경·차량 분리, 깊이 복원, 디퓨전으로 생성한 시점을 비교할 수 있습니다.':'Change the viewpoint and time in a road reconstructed from camera RGB. Compare foreground separation, depth reconstruction and diffusion-generated views.'}</p>
  <div class="joint-layout">
    <div class="joint-observations">
      <figure><figcaption data-joint-rgb-caption>{ko?'관측 RGB':'Observed RGB'}</figcaption><img data-joint-rgb src={showcaseMedia('reality-joint-geometry/calibrated/49.jpg')} width="756" height="420" alt={ko?'선택한 시간의 카메라 RGB':'Camera RGB at the selected time'} loading="lazy" /></figure>
      <figure data-joint-depth-figure><figcaption>{ko?'예측 깊이 · 밝음: 가까움 / 파랑: 멂':'Predicted depth · bright: near / blue: far'}</figcaption><img data-joint-depth-poster src={showcaseMedia('reality-joint-geometry/dense/depth-preview.jpg')} width="252" height="140" alt={ko?'선택한 RGB의 예측 깊이 미리보기':'Predicted depth preview for the selected RGB'} loading="lazy" /><canvas data-joint-depth width="252" height="140" hidden role="img" aria-label={ko?'예측 깊이. 회색은 표시에서 제외한 픽셀입니다.':'Predicted depth. Gray marks display-filtered pixels.'}></canvas></figure>
    </div>
    <div class="joint-stage" data-joint-stage>
      <img class="joint-poster" data-joint-poster src={showcaseMedia('reality-joint-geometry/road/preview.jpg')} width="596" height="389" alt={ko?'실사 RGB로 복원한 도로와 자차 위치':'Road reconstructed from real RGB with an ego-vehicle reference'} loading="lazy" />
      <span class="joint-kind" data-joint-kind>{ko?'RGB 노면 재투영':'RGB road reprojection'}</span>
      <div class="joint-cover" data-joint-cover><div class="joint-start-card"><button data-joint-load type="button"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m12 2 9 5v10l-9 5-9-5V7zM3 7l9 5 9-5M12 12v10"/></svg><span data-joint-load-label>{ko?'3D 시작':'Start 3D'}</span></button><p data-joint-message role="status">{ko?'회전 · 확대 · 시간 이동':'Rotate · Zoom · Scrub time'}</p></div></div>
    </div>
  </div>
  <div data-joint-tools hidden>
    <div class="joint-controls">
      <label>{ko?'비교 모드':'Compare'} <select data-joint-model disabled>
        <optgroup label={ko?'도로 장면':'Road scene'}>
          <option value="road">{ko?'RGB 노면 재투영 + 3D 장면':'Reprojected RGB road + 3D scene'}</option>
          <option value="road-only">{ko?'RGB 노면만 보기':'Reprojected RGB road only'}</option><option value="hybrid">{ko?'3DGS 배경 + 시간별 차량':'3DGS background + time-local vehicles'}</option><option value="nurec">{ko?'기존 고화질 3DGS':'Previous high-quality 3DGS'}</option></optgroup>
        <optgroup label={ko?'깊이 복원 비교':'Depth reconstruction'}><option value="calibrated">{ko?'DA3 · RGB 카메라 보조 입력':'DA3 · RGB/SfM camera priors'}</option><option value="surround">{ko?'DA3 · 주변 카메라 6개':'DA3 · six RGB cameras'}</option><option value="da3">{ko?'DA3 · 전방 카메라':'DA3 · front camera'}</option><option value="aether">{ko?'Aether · 전방 복원':'Aether · front reconstruction'}</option></optgroup>
        <optgroup label={ko?'디퓨전 생성 실험':'Diffusion generation experiments'}><option value="generated-right">{ko?'Aether · 오른쪽 시점 생성':'Aether · generated right views'}</option><option value="generated-left">{ko?'Aether · 왼쪽 시점 생성':'Aether · generated left views'}</option></optgroup>
      </select></label>
      <label data-joint-camera-label>{ko?'카메라':'Camera'} <select data-joint-camera disabled><option value="1">{ko?'앞':'Front'}</option><option value="0">{ko?'뒤':'Back'}</option><option value="2">{ko?'왼쪽 앞':'Front left'}</option><option value="3">{ko?'오른쪽 앞':'Front right'}</option><option value="4">{ko?'왼쪽':'Left'}</option><option value="5">{ko?'오른쪽':'Right'}</option></select></label>
      <div class="joint-presets">{['input','chase','side','overhead'].map((v,i)=><button data-joint-preset={v} disabled type="button">{(ko?['입력 시점','추적','옆','위']:['Input view','Chase','Side','Overhead'])[i]}</button>)}</div>
    </div>
    <div class="joint-timeline"><button data-joint-play disabled type="button">{ko?'재생':'Play'}</button><label class="visually-hidden" for={`joint-frame-${locale}`}>{ko?'재생 위치':'Playback position'}</label><input id={`joint-frame-${locale}`} data-joint-frame type="range" min="0" max="16" value="8" disabled /><output data-joint-time>2.4 s · 9/17</output><button data-joint-close type="button">{ko?'3D 닫기':'Close 3D'}</button></div>
    <p data-joint-status class="joint-status" role="status"></p>
    <p class="joint-help">{ko?'드래그: 회전 · 휠/두 손가락: 확대':'Drag to orbit · Scroll/pinch to zoom'}</p>
    <details class="joint-inspector" data-joint-inspector><summary>{ko?'RGB·깊이 데이터 살펴보기':'Inspect RGB and depth data'}</summary><p data-joint-values class="joint-values">{ko?'왼쪽 RGB의 픽셀을 누르면 깊이와 3D 좌표가 표시됩니다.':'Click a pixel in the RGB panel to inspect its depth and 3D coordinate.'}</p></details>
  </div>
  <nav class="joint-links" aria-label={ko?'연결된 실습':'Related lab views'}><a href="#explore">{ko?'기존 3DGS · 인식과 주행 경로 ↓':'Previous 3DGS · perception and driving path ↓'}</a><a href="#learn">{ko?'동작 원리와 실습 과정':'How it works and how to build it'}</a></nav>
  <p class="joint-caption">PandaSet: Scale AI / Hesai · <a href="https://sketchfab.com/3d-models/volvo-s90-recharge-free-9462b07c10244fd4a28d86846dc9e3a9">Volvo S90: lazercar, CC BY 4.0</a> · <a href={showcaseMedia('reality-joint-geometry/ATTRIBUTION.txt')}>{ko?'출처·라이선스':'Sources and licenses'}</a></p>
</section>
<script>
for(const root of document.querySelectorAll<HTMLElement>('[data-joint-viewer]')){
  let dispose:(()=>void)|undefined,loading=false;
  const q=(name:string)=>root.querySelector<HTMLElement>(`[data-joint-${name}]`)!;
  const load=q('load') as HTMLButtonElement,label=q('load-label'),message=q('message');
  const rgb=q('rgb') as HTMLImageElement,initialRgb=rgb.src;
  const ko=root.dataset.locale==='ko',start=ko?'3D 시작':'Start 3D',hint=ko?'회전 · 확대 · 시간 이동':'Rotate · Zoom · Scrub time';
  function reset(){
    delete root.dataset.jointReady;delete root.dataset.jointModel;
    q('tools').hidden=true;q('cover').hidden=false;q('poster').hidden=false;q('depth-poster').hidden=false;q('depth').hidden=true;q('depth-figure').hidden=false;
    rgb.src=initialRgb;q('rgb-caption').textContent=ko?'관측 RGB':'Observed RGB';q('kind').textContent=ko?'RGB 노면 재투영':'RGB road reprojection';q('kind').dataset.generated='false';label.textContent=start;message.textContent=hint;load.disabled=false;
    (q('model') as HTMLSelectElement).value='road';(q('camera') as HTMLSelectElement).value='1';(q('frame') as HTMLInputElement).value='8';q('time').textContent='2.4 s · 9/17';q('inspector').removeAttribute('open');q('stage').setAttribute('aria-busy','false');
  }
  load.addEventListener('click',async()=>{
    if(loading)return;loading=true;load.disabled=true;label.textContent=ko?'불러오는 중…':'Loading 3D…';message.textContent=ko?'장면을 준비하고 있습니다.':'Preparing the road scene.';q('stage').setAttribute('aria-busy','true');root.dataset.jointLoading='true';
    try{const {mountJointViewer}=await import('../../../labs/nurec-rgb-reality/unified/viewer.js');dispose=await mountJointViewer(root);q('cover').hidden=true;q('poster').hidden=true;q('depth-poster').hidden=true;q('depth').hidden=false;q('tools').hidden=false;q('stage').querySelector('canvas')?.focus({preventScroll:true});}
    catch(error){reset();label.textContent=ko?'다시 시도':'Try again';message.textContent=ko?'장면을 불러오지 못했습니다. 다시 시도해 주세요.':'Could not load the scene. Try again.';console.error(error);}
    finally{loading=false;delete root.dataset.jointLoading;q('stage').setAttribute('aria-busy','false');load.disabled=false;}
  });
  q('close').addEventListener('click',()=>{dispose?.();dispose=undefined;reset();load.focus();});
  window.addEventListener('pagehide',()=>{dispose?.();(root as any).jointViewerCancel?.();},{once:true});
}
</script>
<style>
.joint-viewer{margin-block:3rem}.joint-viewer [hidden]{display:none!important}.joint-viewer p{line-height:1.7}.joint-controls,.joint-presets,.joint-timeline,.joint-links{display:flex;align-items:center;gap:.65rem;flex-wrap:wrap}.joint-controls{padding:1rem 0 .5rem}.joint-controls label{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;max-width:100%;min-width:0}.joint-viewer button,.joint-viewer select{font:inherit;font-size:.85rem;border:1px solid var(--edge,#c9cdd0);color:var(--text,#202428);background:var(--surface,#f6f8fa);padding:.6rem .8rem;border-radius:4px;cursor:pointer;min-height:44px;max-width:100%}.joint-viewer button:focus-visible,.joint-viewer select:focus-visible,.joint-viewer input:focus-visible{outline:3px solid #76b900;outline-offset:3px}.joint-viewer button:disabled,.joint-viewer select:disabled{opacity:.55;cursor:wait}.joint-viewer button[aria-pressed=true]{border-color:#76b900;box-shadow:inset 0 -2px #76b900}.joint-layout{display:grid;grid-template-columns:minmax(220px,1fr) minmax(0,2fr);border:1px solid var(--edge,#c9cdd0);border-radius:5px;overflow:hidden;background:#dce1e5}.joint-observations{display:grid;grid-template-rows:1fr 1fr;background:var(--surface,#f6f8fa)}.joint-observations:has(figure[hidden]){grid-template-rows:1fr}.joint-observations figure{margin:0;min-width:0}.joint-observations img,.joint-observations canvas{display:block;width:100%;height:auto;cursor:crosshair}.joint-observations figcaption{font-size:.7rem;line-height:1.4;padding:.4rem .5rem;color:var(--text,#202428);background:var(--surface,#f6f8fa)}.joint-stage{position:relative;min-width:0;min-height:340px;touch-action:none}.joint-stage :global(canvas){position:absolute;inset:0;display:block;width:100%;height:100%;touch-action:none}.joint-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.joint-kind{position:absolute;left:10px;top:10px;z-index:2;padding:5px 8px;font-size:.7rem;background:#fffffff0;color:#354038;border:1px solid #d7ded7;border-radius:3px;pointer-events:none}.joint-kind[data-generated=true]{border-color:#b68a26;background:#fff6db;color:#715200}.joint-cover{position:absolute;inset:0;z-index:3;display:grid;place-items:start end;padding:16px;background:#ffffff20}.joint-start-card{max-width:100%;padding:16px;display:flex;flex-direction:column;align-items:center;gap:9px;text-align:center;border:1px solid #d7ded7;border-radius:7px;background:#fffffff2;box-shadow:0 5px 24px #1a231a14}.joint-start-card button{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#76b900;color:#102000;border-color:#76b900;font-weight:650;min-height:48px}.joint-start-card button:disabled{opacity:1}.joint-start-card p{margin:0;font-size:.75rem;line-height:1.5;color:#526052;max-width:25ch}.joint-timeline{padding:.5rem 0}.joint-timeline input{flex:1;min-width:100px;accent-color:#76b900}.joint-timeline output{font-variant-numeric:tabular-nums;font-size:.85rem}.joint-status,.joint-help,.joint-caption{font-size:.8rem;color:var(--muted,#59636b)}.joint-status{margin:.5rem 0}.joint-help{margin:0}.joint-inspector{margin-top:.75rem;border-block:1px solid var(--edge,#d8dee4)}.joint-inspector summary{cursor:pointer;min-height:44px;padding:.7rem 0;font-size:.85rem;font-weight:600}.joint-values{font-family:var(--mono,monospace);font-size:.8rem;padding:.8rem 1rem;border-left:3px solid #76b900;background:var(--surface,#f6f8fa);overflow-wrap:anywhere}.joint-links{gap:.25rem 1.25rem;margin-top:.65rem}.joint-links a{display:inline-flex;align-items:center;min-height:44px;font-size:.875rem;text-underline-offset:3px}.joint-caption{margin-top:.25rem}.joint-viewer[data-joint-loading=true] [data-joint-load] svg{display:none}.joint-viewer[data-joint-loading=true] [data-joint-load]::before{content:'';width:16px;height:16px;border:2px solid #10200045;border-top-color:#102000;border-radius:50%;animation:joint-loading .8s linear infinite}@keyframes joint-loading{to{transform:rotate(360deg)}}@media(max-width:650px){.joint-layout{grid-template-columns:1fr}.joint-observations{grid-template-columns:1fr 1fr;grid-template-rows:auto}.joint-observations:has(figure[hidden]){grid-template-columns:1fr}.joint-observations figcaption{font-size:.65rem;min-height:3rem}.joint-stage{height:340px}.joint-start-card{padding:12px}.joint-controls{gap:.6rem}.joint-controls label:first-child{width:100%}.joint-controls label:first-child select{width:100%}.joint-presets{gap:.35rem}.joint-presets button{font-size:.75rem;padding:.5rem}.joint-timeline{gap:.45rem}.joint-timeline output{font-size:.75rem}.joint-kind{font-size:.65rem;max-width:42%}}@media(prefers-reduced-motion:reduce){.joint-viewer[data-joint-loading=true] [data-joint-load]::before{animation:none}}
</style>
