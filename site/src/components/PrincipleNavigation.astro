---
import Icon from './Icon.astro';
import { lessonUrl } from '../lib/learning.mjs';
import { principleProgress, principlesRoute, principlesCopy } from '../lib/principles.mjs';

const { locale, page } = Astro.props;
const progress = principleProgress(page);
const ko = locale === 'ko';
const previousLabel = ko ? '이전 가이드' : 'Previous guide';
const nextLabel = ko ? '다음 가이드' : 'Next guide';
const practiceLabel = principlesCopy[locale].practice;
---
{progress && (
  <nav class:list={['principle-navigation', progress.track.theme]} aria-label={ko ? '학습 순서와 실습' : 'Reading order and practice'}>
    <div class="track-status">
      <a class="track-index" href={lessonUrl(locale, `${principlesRoute}#${progress.track.id}`)}>
        <Icon name={progress.track.icon} size={18} />{progress.track[locale].title}
      </a>
      <span class="track-position" aria-label={ko ? `${progress.track.read.length}개 중 ${progress.position}번째` : `Guide ${progress.position} of ${progress.track.read.length}`}>
        {progress.position} / {progress.track.read.length}
      </span>
    </div>
    <div class="guide-switch">
      {[[progress.previous, previousLabel, 'prev'], [progress.next, nextLabel, 'next']].map(([guide, label, rel]) => guide && (
        <a href={lessonUrl(locale, guide.route)} rel={rel}>
          <span><small>{label}</small><strong>{guide[locale].title}</strong></span><Icon name="right" size={17} />
        </a>
      ))}
    </div>
    <a class="practice-link" href={progress.practice.route.startsWith('https://') ? progress.practice.route : lessonUrl(locale, progress.practice.route)}>
      <span><small>{practiceLabel}</small><strong>{progress.practice[locale]}</strong></span>
      <Icon name={progress.practice.route.startsWith('https://') ? 'external' : 'right'} size={18} />
    </a>
  </nav>
)}

<style>
  .principle-navigation { display: grid; gap: 7px; margin-block: 12px 17px; }
  .track-status { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0 10px; }
  .track-index { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; font-size: .88rem; font-weight: 650; color: var(--route-color); text-underline-offset: 4px; }
  .track-position { padding: 4px 9px; border: 1px solid var(--edge); border-radius: 5px; background: var(--surface); color: var(--text); font-size: .85rem; font-weight: 650; font-variant-numeric: tabular-nums; }
  .guide-switch { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; }
  .guide-switch a:only-child { grid-column: 1 / -1; }
  .guide-switch a, .practice-link { display: flex; justify-content: space-between; align-items: center; gap: 7px; min-width: 0; min-height: 44px; padding: 8px 11px; border: 1px solid var(--edge); border-radius: 7px; background: var(--surface); text-decoration: none; }
  .guide-switch a:hover, .practice-link:hover { border-color: var(--route-color); }
  .guide-switch [rel="prev"] :global(svg) { order: -1; transform: rotate(180deg); }
  .guide-switch [rel="prev"] > span { margin-inline-end: auto; }
  :is(.guide-switch, .practice-link) :global(svg) { flex: none; color: var(--route-color); }
  .principle-navigation small, .principle-navigation strong { display: block; }
  .principle-navigation small { margin-bottom: 3px; color: var(--muted); font-size: .77rem; font-weight: 620; }
  .principle-navigation strong { color: var(--text); font-size: .88rem; line-height: 1.34; overflow-wrap: anywhere; }
  .practice-link { background: var(--route-tint); }
  .practice-link small { color: var(--route-color); }
  :lang(ko) .principle-navigation strong { word-break: keep-all; }
  @media (max-width: 360px) {
    .guide-switch a, .practice-link { padding-inline: 8px; }
  }
</style>
