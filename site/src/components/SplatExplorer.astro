---
import { showcaseMedia } from '../lib/showcase.mjs';
import recorded from '../../../labs/spatial-reconstruction/recorded.json';
import worldgen from '../../../labs/worldgen-scenes/recorded.json';
const { locale, sceneId = 'town03', first = false } = Astro.props;
const generated = sceneId !== 'town03';
const sceneRecord = worldgen.cases.find((row) => row.id === sceneId);
const names = { 'robot-lab': ['Generated robotics laboratory', '생성한 로봇 실험실'], livingroom: ['Expanded living room', '이미지에서 확장한 거실'], 'forest-trail': ['Generated forest trail', '생성한 숲길'] };
const sceneName = generated ? names[sceneId][locale === 'ko' ? 1 : 0] : '';
const titleId = `splat-title-${sceneId}`;
const sectionId = generated && !first ? `explore-${sceneId}` : 'explore';
const ko = locale === 'ko';
const modelMB = ((sceneRecord?.web_preview.bytes ?? recorded.web_preview.bytes) / 1_000_000).toFixed(2);
---
<section class="splat-explorer" id={sectionId} data-locale={locale} data-generated={String(generated)} data-model={showcaseMedia(sceneRecord?.web_preview.file ?? 'town03.spz')} aria-labelledby={titleId}>
  <h2 id={titleId}>{generated ? sceneName : ko ? '직접 시점을 움직여 보기' : 'Explore the reconstructed scene'}</h2>
  <p>{generated ? (ko ? '생성한 공간에서 카메라를 움직여 보세요.' : 'Move through the generated 3D scene.') : ko ? 'fVDB로 복원한 광장을 여러 방향에서 둘러보세요.' : 'Explore the fVDB reconstruction from different viewpoints.'}</p>
  <div class="viewer-shell">
    <div class="viewer-stage" data-stage>
      <img src={showcaseMedia(sceneRecord?.poster ?? 'spatial-reconstruction.jpg')} alt={generated ? sceneName : ko ? 'fVDB로 복원한 분수 광장' : 'Fountain plaza reconstructed with fVDB'} loading="lazy" width="640" height="360" />
      <div class="viewer-cover" data-cover><button type="button" class="button button-primary" data-load>{ko ? '3D 장면 열기' : 'Open 3D scene'}</button></div>
    </div>
    <div class="viewer-toolbar">
      <p role="status" aria-live="polite" data-status>{ko ? '버튼을 눌러 시작하세요.' : 'Open the scene to begin.'}</p>
      <div><button type="button" data-reset disabled>{ko ? '처음 시점' : 'Reset view'}</button><button type="button" data-stop disabled>{ko ? '3D 닫기' : 'Close 3D'}</button></div>
    </div>
    {generated && <div class="viewer-motion" aria-label={ko ? '카메라 위치 이동' : 'Translate camera'}>
      <span>{ko ? '위치 이동' : 'Move camera'}</span>
      {['a', 'w', 's', 'd'].map((key, i) => <button type="button" data-move={key} disabled>{(ko ? ['왼쪽', '앞으로', '뒤로', '오른쪽'] : ['Left', 'Forward', 'Back', 'Right'])[i]}</button>)}
    </div>}
  </div>
  <p class="viewer-help">{ko ? '드래그: 회전 · 휠/두 손가락: 확대 · W/A/S/D: 이동' : 'Drag to orbit · Scroll/pinch to zoom · W/A/S/D to move'}</p>
  <p class="viewer-help"><a href="https://github.com/sparkjsdev/spark">Spark</a> · {generated ? <a href="https://github.com/ZiYang-xie/WorldGen">WorldGen</a> : <a href="https://github.com/carla-simulator/carla/tree/0.9.16#licenses">CARLA</a>}</p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.splat-explorer').forEach((root) => {
    const ko = root.dataset.locale === 'ko';
    const generated = root.dataset.generated === 'true';
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const load = root.querySelector<HTMLButtonElement>('[data-load]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const stop = root.querySelector<HTMLButtonElement>('[data-stop]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const cover = root.querySelector<HTMLElement>('[data-cover]')!;
    let dispose: (() => void) | undefined;
    let resetView: (() => void) | undefined;
    let moveView: ((key: string) => void) | undefined;
    const moveButtons = root.querySelectorAll<HTMLButtonElement>('[data-move]');
    moveButtons.forEach((button) => button.addEventListener('click', () => moveView?.(button.dataset.move!)));
    load.addEventListener('click', async () => {
      document.querySelectorAll<HTMLButtonElement>('.splat-explorer[data-ready] [data-stop]').forEach((button) => button.click());
      load.disabled = true;
      status.textContent = ko ? '뷰어와 3D 장면을 불러오는 중…' : 'Loading viewer and 3D scene…';
      try {
        const [T, { SparkRenderer, SplatMesh }, { OrbitControls }] = await Promise.all([
          import('three'), import('@sparkjsdev/spark'), import('three/addons/controls/OrbitControls.js'),
        ]);
        const scene = new T.Scene(); scene.background = new T.Color('#c5d0d8');
        const camera = new T.PerspectiveCamera(generated ? 80 : 65, 16/9, generated ? .005 : .05, 250);
        camera.up.set(0,generated ? -1 : 0,generated ? 0 : 1);
        const renderer = new T.WebGLRenderer({ antialias: false, powerPreference: 'low-power' });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio,1.5));
        const canvas = renderer.domElement; canvas.tabIndex = 0;
        canvas.setAttribute('aria-label', ko ? '탐색 가능한 3D 장면' : 'Interactive 3D scene'); stage.append(canvas);
        const controls = new OrbitControls(camera, canvas);
        controls.enableDamping = true; controls.minDistance = generated ? .001 : 2; controls.maxDistance = generated ? 10 : 65;
        if (generated) { controls.enableZoom = false; controls.screenSpacePanning = true; }
        const spark = new SparkRenderer({ renderer }); scene.add(spark);
        const splats = new SplatMesh({ url: root.dataset.model }); scene.add(splats);
        resetView = () => { camera.position.set(generated ? 0 : 22,0,generated ? 0 : 5); controls.target.set(0,0,generated ? .01 : 2); controls.update(); };
        resetView();
        moveView = (key) => {
          const forward = camera.getWorldDirection(new T.Vector3());
          forward.addScaledVector(camera.up, -forward.dot(camera.up)).normalize();
          const right = new T.Vector3().crossVectors(forward, camera.up).normalize();
          const delta = forward.multiplyScalar(key === 'w' ? .05 : key === 's' ? -.05 : 0)
            .addScaledVector(right, key === 'd' ? .05 : key === 'a' ? -.05 : 0);
          camera.position.add(delta); controls.target.add(delta); controls.update();
        };
        const resize = new ResizeObserver(() => { camera.aspect = stage.clientWidth/stage.clientHeight; camera.updateProjectionMatrix(); renderer.setSize(stage.clientWidth,stage.clientHeight); });
        resize.observe(stage);
        let visible = true, lastTime = performance.now();
        const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }); observer.observe(stage);
        const keys = new Set<string>();
        canvas.addEventListener('keydown', (e) => { if (!e.ctrlKey && !e.metaKey && !e.altKey && e.key.length===1 && 'wasd'.includes(e.key.toLowerCase())) { e.preventDefault(); keys.add(e.key.toLowerCase()); } });
        canvas.addEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));
        canvas.addEventListener('blur', () => keys.clear());
        renderer.setAnimationLoop(() => {
          const time = performance.now(), dt = Math.min((time-lastTime)/1000,.05); lastTime = time;
          if (!visible || document.hidden) return;
          if (keys.size) {
            const direction = camera.getWorldDirection(new T.Vector3()); direction.addScaledVector(camera.up,-direction.dot(camera.up)).normalize();
            const side = new T.Vector3().crossVectors(direction,camera.up).normalize();
            const delta = direction.multiplyScalar((Number(keys.has('w'))-Number(keys.has('s')))*dt*(generated ? .2 : 5))
              .addScaledVector(side,(Number(keys.has('d'))-Number(keys.has('a')))*dt*(generated ? .2 : 5));
            camera.position.add(delta); controls.target.add(delta);
          }
          controls.update(); renderer.render(scene,camera);
        });
        dispose = () => { renderer.setAnimationLoop(null); resize.disconnect(); observer.disconnect(); controls.dispose(); splats.dispose(); spark.dispose(); renderer.dispose(); renderer.forceContextLoss(); canvas.remove(); resetView=undefined; moveView=undefined; moveButtons.forEach((button) => button.disabled=true); };
        await splats.initialized;
        cover.hidden=true; root.dataset.ready='true'; moveButtons.forEach((button) => button.disabled=false); reset.disabled=stop.disabled=false;
        status.textContent=ko ? '3D 장면을 불러왔습니다. 드래그해서 둘러보세요.' : 'Scene loaded. Drag to look around.';
      } catch (error) {
        dispose?.(); dispose=undefined; load.disabled=false;
        status.textContent=ko ? '이 브라우저에서는 3D를 열지 못했습니다. 아래 영상을 재생해 주세요.' : 'The 3D viewer could not start here. Watch the recording below.';
        console.error('Splat viewer:',error);
      }
    });
    reset.addEventListener('click',()=>resetView?.());
    stop.addEventListener('click',()=>{
      dispose?.(); dispose=undefined; cover.hidden=false; load.disabled=false; reset.disabled=stop.disabled=true;
      delete root.dataset.ready; status.textContent=ko ? '3D를 닫았습니다.' : '3D closed.';
    });
    window.addEventListener('pagehide',()=>dispose?.(),{once:true});
  });
</script>
<style>
  .splat-explorer { margin-block: 2rem; }
  h2 { font-size: clamp(1.5rem,2.6vw,1.75rem); margin-bottom: 12px; }
  p { line-height: 1.75; color: var(--muted); }
  .viewer-shell { margin-top: 16px; border: 1px solid var(--edge); border-radius: 8px; overflow: clip; }
  .viewer-stage { aspect-ratio: 16/9; position: relative; background: var(--surface); }
  .viewer-stage img { width: 100%; height: 100%; object-fit: cover; }
  .viewer-stage :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .viewer-cover { position: absolute; inset: 0; display: grid; place-items: center; background: #0003; z-index: 1; }
  .viewer-cover[hidden] { display: none; }
  .viewer-toolbar { padding: 10px 14px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; background: var(--surface); }
  .viewer-toolbar p { margin: 0; font-size: .875rem; }
  .viewer-toolbar button { padding: 10px; min-height: 44px; background: transparent; color: var(--text); border: 1px solid var(--edge); border-radius: 4px; cursor: pointer; }
  button:disabled { opacity: .5; cursor: default; }
  .viewer-toolbar div { display: flex; gap: 8px; }
  .viewer-motion { display:flex; flex-wrap:wrap; align-items:center; gap:8px; padding:12px; background:var(--surface); border-top:1px solid var(--edge); }
  .viewer-motion button { min-height:44px; padding:8px 14px; border:1px solid var(--edge); border-radius:4px; background:var(--surface-strong, var(--surface)); color:var(--text); cursor:pointer; }
  .viewer-help { margin-top: 12px; font-size: .9rem; }
  a { text-decoration: underline; text-underline-offset: 3px; }
</style>
