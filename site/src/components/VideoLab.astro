---
import Base from '../layouts/Base.astro';
import GuideCommands from './GuideCommands.astro';
import Icon from './Icon.astro';
import LessonLanding from './LessonLanding.astro';
import LessonPreview from './LessonPreview.astro';
import LessonTheory from './LessonTheory.astro';
import PlacementExercise from './PlacementExercise.astro';
import ShowcaseVideo from './ShowcaseVideo.astro';
import SplatExplorer from './SplatExplorer.astro';
import RgbRealityViewer from './RgbRealityViewer.astro';
import HumanGaussianViewer from './HumanGaussianViewer.astro';
import ToolTags from './ToolTags.astro';
import { catalogSearchUrl, pageUrl, repositoryFile } from '../lib/catalog.mjs';
import { renderCodeBlock } from '../lib/code-blocks.mjs';
import { labCode, labCopy } from '../lib/labs.mjs';
import { courseRoute, courses, firstExerciseRoute, learningCopy } from '../lib/learning.mjs';
import { lessonFlows } from '../lib/lesson-flows.mjs';
import { renderGuide } from '../lib/markdown.mjs';
import { additionalRecordings, clips, grids, showcaseMedia } from '../lib/showcase.mjs';
import { topicForPage, topicsCopy } from '../lib/topics.mjs';

const { locale, lab } = Astro.props;
const { id, tags, evidence } = lab;
const labels = labCopy[locale];
const path = `docs/${locale}/labs/${id}.md`;
const clip = [...grids, ...clips].find((item) => item.id === id);
const entry = clip[locale];
const { title = entry.title, headings, html, theory } = renderGuide(locale, path, ['implementation', 'run', 'verify'], 'implementation');
const code = labCode(lab).filter(({ name }) => !lab.codePreview || lab.codePreview.includes(name));
const course = courses.find(({ lessons, advanced }) =>
  advanced?.route === `labs/${id}` ||
  lessons.some(({ route }) => route !== firstExerciseRoute && route.split('#')[0] === `labs/${id}`)
);
const isPlacement = id === 'gr00t-placement';
const startLabel = learningCopy[locale].firstExercise;
const exampleLabel = locale === 'ko' ? '실행 영상과 기록' : 'Example run and recording';
const topic = topicForPage(`labs/${id}`);
const topicLabels = topicsCopy[locale];
const ko = locale === 'ko';
const preparation = {
  'nurec-rgb-reality': ko ? 'NuRec·Harmonizer·Alpamayo를 실제 실행한 RGB 전용 실습입니다. GPU 없이도 저장된 장면과 출력을 볼 수 있습니다.' : 'An RGB-only NuRec, Harmonizer and Alpamayo run. Explore the saved scene and model outputs without a CUDA GPU.',
  'rgb-reality-view': ko ? '브라우저에서 먼저 둘러보세요. 직접 복원하려면 Linux와 RTX 5090 한 장이 필요합니다.'
    : 'Explore in the browser first. The tested reconstruction preset uses Linux and one RTX 5090.',
  'human-4d-gaussian': ko ? '브라우저에서 SOMA 합성 제어 샘플을 먼저 살펴보세요. 본인 영상으로 인체를 복원하는 과정은 NVIDIA GPU 실습으로 이어집니다.' : 'Start with the synthetic SOMA control in your browser, then follow the NVIDIA GPU workflow for a local video you can use.',
  'gr00t-placement': ko ? '브라우저에서 시작합니다. 정책을 직접 실행하려면 RTX Linux 환경이 필요합니다.'
    : 'Start in the browser. Running the policy requires RTX on Linux.',
  'replicator-outputs': ko ? '심화 실습 · RTX GPU, Isaac Sim 6.1, Isaac Lab 필요.'
    : 'Advanced lab · RTX GPU, Isaac Sim 6.1, and Isaac Lab.',
  'scene-to-data': ko ? '동봉한 데이터로 점군을 만들 때는 Python 3.12만 있으면 됩니다.'
    : 'Reconstruct the bundled point cloud with Python 3.12.',
}[id];
const steps = [
  ...(isPlacement ? [{ id: 'first-exercise', label: startLabel }] : []),
  ...headings,
  ...(['nurec-rgb-reality', 'rgb-reality-view', 'spatial-reconstruction', 'worldgen-scenes', 'human-4d-gaussian'].includes(id) ? [{ id: 'explore', label: id === 'human-4d-gaussian' ? (ko ? 'RGB·3D 동작 비교' : 'Compare RGB and 3D motion') : (ko ? '3D 공간 둘러보기' : 'Explore the 3D scene') }] : []),
  { id: 'example-run', label: exampleLabel },
  { id: 'code', label: labels.code },
];
---
<Base locale={locale} page={`labs/${id}`} title={title} description={entry.description}>
  <LessonLanding locale={locale} title={title} description={entry.description} theme={topic.theme} steps={steps} preparation={preparation}>
    <Fragment slot="breadcrumbs">
      <a class="breadcrumb" href={pageUrl(locale, `topics/${topic.slug}`)}>{topic[locale].title}</a>
      {course && <a class="breadcrumb" href={pageUrl(locale, courseRoute(course.slug))}>{course[locale].title}</a>}
    </Fragment>
    <ToolTags slot="facts" tags={tags} label={labels.tools} />
    <Fragment slot="actions">
      {['nurec-rgb-reality', 'rgb-reality-view', 'spatial-reconstruction', 'worldgen-scenes', 'human-4d-gaussian'].includes(id) && <a class="button button-primary" href="#explore">{id === 'human-4d-gaussian' ? (ko ? 'RGB·3D 비교 실습' : 'Compare RGB and 3D') : (ko ? '3D 공간 직접 둘러보기' : 'Explore the 3D scene')}</a>}
      {isPlacement && <a class="button button-primary" href="#first-exercise">{startLabel}<Icon name="down" size={16} /></a>}
      <a class:list={isPlacement ? 'plain-link' : ['button', ['nurec-rgb-reality', 'rgb-reality-view', 'spatial-reconstruction', 'worldgen-scenes', 'human-4d-gaussian'].includes(id) ? 'button-secondary' : 'button-primary']} href="#run">{labels.run}<Icon name="down" size={16} /></a>
      {tags.includes('Replicator') && (
        <a class="plain-link" href={catalogSearchUrl(locale, 'Replicator')}>
          {ko ? '카탈로그에서 Replicator 보기' : 'Replicator in the catalog'} <Icon name="right" size={17} />
        </a>
      )}
      <a class="plain-link" href="#code">{labels.code} <Icon name="down" size={16} /></a>
      <a class="plain-link" href={repositoryFile(path)}>{labels.github} <Icon name="external" size={16} /></a>
    </Fragment>
    <LessonPreview slot="preview" image={showcaseMedia(`${clip.media?.[locale] ?? id}.jpg`)} alt={entry.title} caption={topicLabels.recording}
      href="#example-run" label={exampleLabel} />
    {isPlacement && <PlacementExercise locale={locale} />}
    {['nurec-rgb-reality', 'rgb-reality-view'].includes(id) && <RgbRealityViewer locale={locale} id={id} />}
    {id === 'human-4d-gaussian' && <HumanGaussianViewer locale={locale} manifestUrl={showcaseMedia('human-4d-control/manifest.json')} reference={true} />}
    <LessonTheory locale={locale} page={`labs/${id}`} flow={lessonFlows[id]} theory={theory} showPixels={id === 'scene-to-data'} />
    <GuideCommands locale={locale} />
    <div class="prose" set:html={html} />
    {id === 'spatial-reconstruction' && <SplatExplorer locale={locale} />}
    {id === 'worldgen-scenes' && ['robot-lab', 'livingroom', 'forest-trail'].map((sceneId, index) => <SplatExplorer locale={locale} sceneId={sceneId} first={index === 0} />)}
    <section class="lab-video" id="example-run" aria-labelledby="example-run-title">
      <h2 id="example-run-title">{exampleLabel}</h2>
      <div class="video-preview"><ShowcaseVideo locale={locale} clip={clip} title={entry.title} /></div>
      {additionalRecordings.filter((recording) => recording.lab === id && !recording.labRoute).map((recording) => (
        <div class="additional-recording" id={recording.id}>
          <h3>{recording[locale].title}</h3>
          <p>{recording[locale].description}</p>
          <div class="video-preview"><ShowcaseVideo locale={locale} clip={recording} title={recording[locale].title} /></div>
        </div>
      ))}
      <div class="lab-video-links">
        <a class="plain-link" href={repositoryFile(`labs/${id}/${evidence}`)}>{labels.evidence}<Icon name="external" size={16} /></a>
        <a class="plain-link" href={`${pageUrl(locale, 'showcase')}#${id}`}>{labels.back}<Icon name="right" size={16} /></a>
      </div>
    </section>
    <section class="lab-code" id="code" aria-labelledby="code-title">
      <h2 id="code-title">{labels.code}</h2>
      {lab.codePreview && <p><a class="plain-link" href={repositoryFile(`labs/${id}`)}>{ko ? "단계별 실행기·학습 코드·검사 도구 전체 보기" : "Browse all stage adapters, training code and validation tools"}<Icon name="external" size={16} /></a></p>}
      {code.map(({ name, path, source }) => (
        <details>
          <summary><code>{name}</code><Icon name="chevron" size={16} /></summary>
          <a class="plain-link" href={repositoryFile(path)}>{labels.github}<Icon name="external" size={16} /></a>
          <Fragment set:html={renderCodeBlock(source, path.split('.').at(-1), locale)} />
        </details>
      ))}
    </section>
  </LessonLanding>
</Base>

<style>
  .lab-video, .lab-code { margin-block: 2rem; }
  :is(.lab-video, .lab-code) h2 { margin-bottom: 12px; font-size: clamp(1.5rem, 2.6vw, 1.75rem); line-height: 1.25; letter-spacing: -.02em; }
  .lab-video-links { display: flex; flex-wrap: wrap; gap: 0 16px; }
  .lab-video-links a { min-height: 44px; }
  .video-preview { overflow: clip; border: 1px solid var(--edge); border-radius: 8px; }
  .additional-recording { margin-block-start: 24px; }
  .additional-recording h3 { font-size: 1.15rem; }
  .additional-recording p { color: var(--muted); line-height: 1.7; margin-block: 8px 12px; }
  .lab-code details { border-block-start: 1px solid var(--edge); }
  .lab-code details:last-child { border-block-end: 1px solid var(--edge); }
  .lab-code details[open] { padding-bottom: 13px; }
  .lab-code summary {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    min-height: 44px; padding-block: 7px; color: var(--text); list-style: none; cursor: pointer;
  }
  .lab-code summary:hover, .lab-code details[open] summary { color: var(--accent); }
  .lab-code summary::-webkit-details-marker { display: none; }
  .lab-code summary code { font-size: .875rem; overflow-wrap: anywhere; min-width: 0; }
  .lab-code summary :global(svg) { flex: none; }
  .lab-code details[open] summary :global(svg) { rotate: 180deg; }
  .lab-code :global(.code-block pre) { max-height: 32rem; }
</style>
