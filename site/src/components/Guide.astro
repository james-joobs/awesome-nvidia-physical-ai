---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import LessonLanding from './LessonLanding.astro';
import LessonPreview from './LessonPreview.astro';
import LessonTheory from './LessonTheory.astro';
import { cubeScene } from '../lib/assets.mjs';
import { catalogSearchUrl, copy, modelGuide, pageUrl, repositoryFile, workflows } from '../lib/catalog.mjs';
import { courseRoute, onboardingGuides, workbenchRoute } from '../lib/learning.mjs';
import { lessonFlows } from '../lib/lesson-flows.mjs';
import { renderGuide, renderModelList } from '../lib/markdown.mjs';
import { principlesCopy, principlesRoute } from '../lib/principles.mjs';
import { topicForPage, topicsCopy } from '../lib/topics.mjs';

const { locale, page, guide, sourcePath, parent } = Astro.props;
const labels = copy[locale];
const entry = guide[locale];
const flow = guide.flow ?? lessonFlows[page.split('/').at(-1)];
const { headings, html, theory } = renderGuide(locale, sourcePath, guide.sections, flow && guide.sections[0]);
const isCube = guide.slug === 'isaac-sim-first-cube';
const isWorkbench = page === workbenchRoute;
const isSetup = page.startsWith('onboarding/');
const isModels = page === modelGuide.route;
const isTool = page.startsWith('tools/');
const models = isModels ? renderModelList(locale) : undefined;
const steps = isModels ? [...headings, { id: 'comparison-table', label: labels.modelTable }] : headings;
const topic = topicForPage(page);
const media = topic?.entries.find((item) => item.page === page);
const isReference = Boolean(guide.source) || isModels;
const topicLabels = topicsCopy[locale];
const ko = locale === 'ko';
const caption = media?.credit ? topicLabels.officialMedia : topicLabels.capturedMedia;
const start = guide.flow ? headings[0] : headings.find(({ id }) => id !== 'implementation');
const startLabel = isWorkbench ? (ko ? 'GPU 없이 시작하기' : 'Start without a GPU') : start.label;
const sectionViews = isModels ? [
  { id: start.id, label: labels.modelEvaluation },
  { id: 'comparison-table', label: labels.modelTable },
] : isTool ? headings.filter(({ id }) => labels.toolSections[id])
  .map(({ id }) => ({ id, label: labels.toolSections[id] })) : [];
const preparation = isWorkbench
  ? (ko ? '저장된 데이터는 Python 3.12로 검사합니다. 새 촬영에는 RTX GPU와 Isaac Sim 6.2가 필요합니다.'
    : 'Use Python 3.12 to check the saved data. For a new capture, use an RTX GPU and Isaac Sim 6.2.')
  : guide.slug === 'alpasim-closed-loop'
    ? (ko ? '공식 예제 기준. Linux, NVIDIA GPU, Docker, NuRec 접근 권한이 필요합니다.'
      : 'Official example. Requires Linux, an NVIDIA GPU, Docker, and NuRec access.')
    : undefined;
---
<Base locale={locale} page={page} title={entry.title} description={entry.description}>
  <LessonLanding locale={locale} title={entry.title} description={entry.description}
    theme={guide.theme ?? topic?.theme} steps={steps} reference={isReference} toolGuide={isTool} preparation={preparation}>
    <Fragment slot="breadcrumbs">
      {isTool && <>
        <a class="breadcrumb" href={pageUrl(locale, principlesRoute)}>{principlesCopy[locale].nav}</a>
        <Icon name="right" size={14} />
      </>}
      {isSetup ? <a class="breadcrumb" href={`${pageUrl(locale)}#onboarding`}>{labels.setup}</a>
        : topic ? <a class="breadcrumb" href={pageUrl(locale, `topics/${topic.slug}`)}>{topic[locale].title}</a>
        : <a class="breadcrumb" href={`${pageUrl(locale)}#${parent}`}>{labels[parent]}</a>}
      {isWorkbench && <a class="breadcrumb" href={pageUrl(locale, courseRoute('simulation-data'))}>{labels.workflows}</a>}
    </Fragment>
    <Fragment slot="actions">
      {isCube ? (
        <a class="button button-primary" href={cubeScene} download="cube-drop.usda">
          {labels.download} <Icon name="download" size={18} />
        </a>
      ) : isModels ? (
        <a class="button button-primary" href="#comparison-table">{labels.modelTable}<Icon name="down" size={16} /></a>
      ) : (
        <a class="button button-primary" href={`#${start.id}`}>
          {startLabel} <Icon name="down" size={16} />
        </a>
      )}
      <a class="plain-link" href={repositoryFile(sourcePath)}>{labels.source} <Icon name="external" size={17} /></a>
      {isWorkbench && (
        <a class="plain-link" href={catalogSearchUrl(locale, 'Replicator')}>
          {ko ? '카탈로그에서 Replicator 보기' : 'Replicator in the catalog'} <Icon name="right" size={17} />
        </a>
      )}
      {isCube && (
        <a class="plain-link" href={repositoryFile(`docs/${locale}/isaac-sim.md`)}>
          {labels.isaacSimGuide} <Icon name="external" size={17} />
        </a>
      )}
    </Fragment>
    {media && <LessonPreview slot="preview" image={media.image} alt={media[locale].alt} fit={media.fit}
      caption={caption} href={media.credit?.url} label={media.credit?.label} external />}
    {(isSetup || sectionViews.length > 0) && (
      <div slot="navigation" class="hub-band">
        {isSetup ? (
          <nav class="shell hub-views guide-views" aria-label={labels.setup}>
            {onboardingGuides.map((item) => (
              <a href={pageUrl(locale, item.page)} aria-current={item.page === page ? 'page' : undefined}>{item[locale].title}</a>
            ))}
          </nav>
        ) : (
          <nav class:list={['shell hub-views guide-views section-views', { 'model-views': isModels, 'tool-views': isTool }]}
            aria-label={isModels ? labels.models : labels.onThisPage}>
            {sectionViews.map(({ id, label }, index) => (
              <a href={`#${id}`} aria-current={index === 0 ? 'location' : undefined}>{label}</a>
            ))}
          </nav>
        )}
      </div>
    )}
    {theory && <LessonTheory locale={locale} page={page} flow={flow} theory={theory} showPixels={isWorkbench} />}
    <div class:list={['prose', { 'setup-steps': isSetup }]} set:html={html} />
    {models && (
      <section class="prose model-list" id="comparison-table" aria-labelledby="comparison-heading">
        <h2 id="comparison-heading">{labels.modelTable}</h2>
        <p class="model-table-hint">{labels.modelTableHint}</p>
        <Fragment set:html={models} />
      </section>
    )}
    {guide.slug && (
      <nav slot="related" class="related-workflows" aria-label={labels.otherWorkflows}>
        <h2>{labels.otherWorkflows}</h2>
        {workflows.filter(({ slug }) => slug !== guide.slug).map((workflow) =>
          <a class="plain-link" href={pageUrl(locale, `workflows/${workflow.slug}`)}>
            {workflow[locale].title} <Icon name="right" size={17} />
          </a>
        )}
      </nav>
    )}
  </LessonLanding>
</Base>

<script>
  const views = [...document.querySelectorAll<HTMLAnchorElement>('.section-views a')];
  if (views.length) {
    const sections = [...document.querySelectorAll<HTMLAnchorElement>('#lesson-steps a')].map(link => link.hash);
    const viewHashes = new Set(views.map(link => link.hash));
    const updateView = () => {
      const position = sections.indexOf(window.location.hash);
      const active = sections.slice(0, position + 1).findLast(hash => viewHashes.has(hash)) ?? views[0].hash;
      views.forEach(link => {
        if (link.hash === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    updateView();
    window.addEventListener('hashchange', updateView);
  }
</script>

<style>
  .guide-views a { min-width: 0; overflow-wrap: anywhere; }
  .setup-steps > :global(h2), .model-list > h2 { padding-bottom: 9px; border-bottom: 1px solid var(--edge); }
  .model-list { container: model-comparison / inline-size; --model-name-width: clamp(7rem, 19vw, 9rem); }
  .model-list > h2 { margin-top: 46px; }
  .model-table-hint { color: var(--muted); font-size: .875rem; line-height: 1.55; }
  .model-list :global(table) { min-width: 48rem; table-layout: fixed; border-collapse: separate; border-spacing: 0; }
  .model-list :global(:is(th, td)) { padding: 10px 11px; line-height: 1.55; }
  .model-list :global(thead th:first-child) { width: var(--model-name-width); }
  .model-list :global(thead th:nth-child(2)) { width: 25%; }
  .model-list :global(thead th:last-child) { width: clamp(7rem, calc(100cqw - var(--model-name-width) - .5rem), 12rem); }
  .model-list :global(tbody tr > *) { border-top: 1px solid var(--edge); }
  .model-list :global(tr > :first-child) { position: sticky; inset-inline-start: 0; z-index: 1; border-inline-end: 1px solid var(--edge); background: var(--bg); }
  .model-list :global(thead tr > :first-child) { background: var(--table-head); }
  @container model-comparison (width >= 48rem) {
    .model-table-hint { display: none; }
  }
  :lang(ko) :is(.guide-views a, .model-table-hint) { word-break: keep-all; overflow-wrap: anywhere; }
  @media (max-width: 570px) {
    .guide-views a { font-size: .875rem; }
    .tool-views:has(> a:nth-child(4)) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
