---
import '../styles/human-gaussian.css';
import {humanGaussianMarkup} from '../lib/human-gaussian-markup.mjs';
const {locale,manifestUrl='',reference=true,id='explore'}=Astro.props;
const controlSample=Astro.props.controlSample??manifestUrl.includes('human-4d-control');
const youtubeSource=Astro.props.youtubeSource??manifestUrl.includes('human-4d-dance');
const sourcePosterUrl=Astro.props.sourcePosterUrl??(controlSample?manifestUrl.replace(/manifest\.json$/,'ui-source-poster.jpg'):'');
const modelPosterUrl=Astro.props.modelPosterUrl??((controlSample||youtubeSource)?manifestUrl.replace(/manifest\.json$/,controlSample?'ui-model-poster.jpg':'poster.jpg'):'');
---
<section class="human-gaussian" id={id} data-human-gaussian data-locale={locale} data-manifest={manifestUrl} set:html={humanGaussianMarkup(locale,{manifestUrl,reference,controlSample,youtubeSource,sourcePosterUrl,modelPosterUrl})} />
<script>
import {humanGaussianCopy} from '../lib/human-gaussian-markup.mjs';
for(const root of document.querySelectorAll<HTMLElement>('[data-human-gaussian]')){
 let active:any;let loading=false;
 const load=root.querySelector<HTMLButtonElement>('[data-hg-load]')!;
 const copy=humanGaussianCopy[root.dataset.locale==='ko'?'ko':'en'];
 const label=root.querySelector<HTMLElement>('[data-hg-load-label]')!;
 const close=root.querySelector<HTMLButtonElement>('[data-hg-close]')!;
 const pair=root.querySelector<HTMLElement>('[data-hg-pair]')!;
 root.dataset.layout=pair.dataset.mode;
 for(const button of root.querySelectorAll<HTMLButtonElement>('[data-hg-mode]'))button.addEventListener('click',()=>{
  pair.dataset.mode=button.dataset.hgMode;root.dataset.layout=button.dataset.hgMode;
  root.querySelectorAll('[data-hg-mode]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
  if(active?.state.ready&&button.dataset.hgMode!=='source')active.seek(active.state.seconds);
 });
 async function open(){
  if(loading)return;active?.dispose();active=undefined;loading=true;root.dataset.loading='true';load.disabled=true;label.textContent=copy.loading;
  root.querySelector<HTMLElement>('[data-hg-cover-message]')!.textContent=copy.loading;
  try{const {mountHumanGaussianViewer}=await import('../lib/human-gaussian-viewer.mjs');active=await mountHumanGaussianViewer(root);}
  catch(error){root.querySelector<HTMLElement>('[data-hg-cover-message]')!.textContent=copy.loadError;console.error(error);}
  finally{loading=false;delete root.dataset.loading;root.querySelector('[data-hg-stage]')!.setAttribute('aria-busy','false');load.disabled=false;load.hidden=false;label.textContent=active?.state.ready?copy.load:copy.retry;if(active?.state.ready)active.renderer.domElement.focus({preventScroll:true});}
 }
 load.addEventListener('click',()=>open());
 close.addEventListener('click',()=>{active?.dispose();active=undefined;label.textContent=copy.load;load.focus({preventScroll:true});});window.addEventListener('pagehide',()=>active?.dispose(),{once:true});
}
</script>
