---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import ShowcaseVideo from './ShowcaseVideo.astro';
import ToolTags from './ToolTags.astro';
import { catalogSearchUrl, pageUrl } from '../lib/catalog.mjs';
import { courseRoute, learningCopy } from '../lib/learning.mjs';
import { topics, topicsCopy } from '../lib/topics.mjs';

const { locale, topic } = Astro.props;
const labels = topicsCopy[locale];
const group = topic ? [topic] : topics;
const route = topic ? `topics/${topic.slug}` : 'topics';
const heading = topic?.[locale].title ?? labels.browse;
const description = topic?.[locale].description ?? labels.intro;
const topicLinks = [
  { page: 'topics', title: labels.all },
  ...topics.map((item) => ({ page: `topics/${item.slug}`, title: item[locale].title })),
];
---
<Base locale={locale} page={route} title={heading} description={description}>
  <header class="shell gallery-header">
    <a class="breadcrumb" href={`${pageUrl(locale)}#topics`}>{labels.nav}</a>
    <h1>{heading}</h1>
    <p>{description}</p>
    {topic?.course && <a class="plain-link course-link" href={pageUrl(locale, courseRoute(topic.course))}>{learningCopy[locale].openPath}<Icon name="right" size={18} /></a>}
  </header>
  <div class="hub-band">
    <nav class="shell hub-views topic-switcher" aria-label={labels.topicNav}>
      {topicLinks.map(({ page, title }) => <a href={pageUrl(locale, page)} aria-current={page === route ? 'page' : undefined}>{title}</a>)}
    </nav>
    <details class="shell topic-picker">
      <summary><span>{labels.topicNav}</span><strong>{topic ? heading : labels.all}</strong><Icon name="chevron" size={16} /></summary>
      <nav aria-label={labels.topicNav}>
        {topicLinks.map(({ page, title }) => <a href={pageUrl(locale, page)} aria-current={page === route ? 'page' : undefined}>{title}</a>)}
      </nav>
    </details>
  </div>
  <div class="shell topic-gallery">
    {group.map((section) => (
      <section class="topic-group" aria-labelledby={`gallery-${section.slug}`}>
        <h2 id={`gallery-${section.slug}`}>
          {topic ? labels.examples
            : <a href={pageUrl(locale, `topics/${section.slug}`)}>{section[locale].title}<Icon name="right" size={20} /></a>}
        </h2>
        <div class:list={['example-grid', { 'single-example': topic && section.entries.length === 1 }]}>
          {section.entries.map((item) => {
            const { title, description, alt } = item[locale];
            const url = pageUrl(locale, item.page);
            return (
              <article class="example-card">
                <div class="example-media">
                  {item.clip ? <ShowcaseVideo locale={locale} clip={item.clip} title={title} /> : (
                    <a class:list={['example-image', item.fit]} href={url} aria-label={title}>
                      <img src={item.image} alt={alt} loading="lazy" decoding="async" />
                    </a>
                  )}
                </div>
                <div class="example-copy">
                  <p class="example-kind">{labels[item.kind]}</p>
                  <h3><a href={url}>{title}</a></h3>
                  <p class="example-description">{description}</p>
                  <ToolTags tags={item.tools} label={labels.tools} />
                  <div class="example-actions">
                    <a class="plain-link" href={url} aria-label={`${item.kind === 'official' ? labels.openGuide : labels.openLab} · ${title}`}>
                      {item.kind === 'official' ? labels.openGuide : labels.openLab}<Icon name="right" size={18} />
                    </a>
                    {item.credit && <a class="credit" href={item.credit.url}>{labels.officialMedia} · {item.credit.label}<Icon name="external" size={14} /></a>}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        {section.resources?.map(([target, en, ko]) => (
          <a class="plain-link extra-guide" href={pageUrl(locale, target)}>{locale === 'ko' ? ko : en}<Icon name="right" size={18} /></a>
        ))}
        <div class="topic-theory">
          {topic ? <h2>{labels.principles}</h2> : <h3>{labels.principles}</h3>}
          <ul role="list">
            {section.guides.map((guide) => (
              <li><a class="hub-entry" href={pageUrl(locale, guide.page)}>
                <span><strong>{guide[locale].title}</strong><span class="hub-summary">{guide[locale].description}</span></span>
                <Icon name="right" size={17} />
              </a></li>
            ))}
          </ul>
        </div>
        {topic && (
          <nav class="topic-links" aria-label={labels.tools}>
            <h2>{labels.tools}</h2>
            <div>{section.stacks.map((stack) => <a class="plain-link" href={catalogSearchUrl(locale, stack)}>{stack}<Icon name="right" size={15} /></a>)}</div>
          </nav>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  .gallery-header { padding-block: clamp(28px, 4vw, 55px) 26px; }
  .gallery-header h1 { margin-block: 8px 12px; font-size: clamp(1.875rem, 4vw, 2.5rem); line-height: 1.2; }
  .gallery-header p { max-width: 46rem; color: var(--prose-text); line-height: 1.75; }
  .course-link { min-height: 44px; margin-top: 5px; }
  .topic-picker { display: none; }
  .topic-gallery { padding-block: clamp(27px, 5vw, 60px) clamp(40px, 6vw, 72px); }
  .topic-group + .topic-group { margin-top: 42px; padding-top: 26px; border-top: 1px solid var(--edge); }
  .topic-group > h2 { margin-bottom: 20px; padding-bottom: 9px; border-bottom: 1px solid var(--edge); font-size: 1.45rem; line-height: 1.25; }
  .topic-group > h2 a { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .topic-group > h2 a :global(svg), .topic-group > h2 a:hover { color: var(--accent); }
  .example-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .example-grid.single-example { grid-template-columns: minmax(0, 64rem); }
  .example-card {
    display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--edge);
    background: var(--bg); box-shadow: 0 2px 6px var(--shadow);
  }
  .example-card:focus-within { border-color: var(--accent); }
  .example-media { border-bottom: 1px solid var(--edge); min-width: 0; }
  .example-image { display: block; aspect-ratio: 16 / 9; background: var(--media-bg); }
  .example-image:focus-visible { outline-offset: -4px; }
  .example-image img { width: 100%; height: 100%; object-fit: cover; }
  .example-image.contain img { object-fit: contain; padding: 12%; }
  .example-copy { flex: 1; display: flex; flex-direction: column; align-items: start; gap: 8px; padding: 16px 18px 12px; }
  .example-kind { color: var(--muted); font-size: .78rem; font-weight: 620; }
  .example-copy h3 { font-size: clamp(1.1rem, 2vw, 1.28rem); line-height: 1.35; overflow-wrap: anywhere; }
  .example-copy h3 a { text-decoration-color: var(--brand-green); text-underline-offset: 3px; }
  .example-copy h3 a:hover { color: var(--accent); }
  .example-description { color: var(--prose-text); font-size: .9375rem; line-height: 1.6; overflow-wrap: anywhere; }
  .example-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0 14px; width: 100%; margin-top: auto; }
  .example-actions a { min-height: 44px; }
  .credit { display: inline-flex; align-items: center; gap: 4px; color: var(--muted); font-size: .78rem; text-underline-offset: 3px; }
  .credit :global(svg) { flex: none; }
  .extra-guide { min-height: 44px; margin-top: 8px; }
  .topic-theory, .topic-links { margin-top: 28px; }
  .topic-theory :is(h2, h3), .topic-links h2 { margin-bottom: 10px; font-size: 1.25rem; }
  .topic-theory ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; margin: 0; padding: 0; border-top: 1px solid var(--edge); list-style: none; }
  .topic-theory li { min-width: 0; border-bottom: 1px solid var(--edge); }
  .topic-links { padding-top: 20px; border-top: 1px solid var(--edge); }
  .topic-links div { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .topic-links a { min-height: 44px; }
  :lang(ko) :is(.gallery-header p, .example-description) { word-break: keep-all; }
  @media (min-width: 761px) {
    .single-example .example-card { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; }
    .single-example .example-media { border-inline-end: 1px solid var(--edge); border-bottom: 0; }
    .single-example .example-copy { padding: 20px 24px; }
  }
  @media (max-width: 1040px) {
    .topic-switcher { display: none; }
    .topic-picker { display: block; }
    .topic-picker > summary {
      display: flex; align-items: center; gap: 6px 10px; min-height: 54px;
      padding-block: 7px; list-style: none; cursor: pointer; font-size: .875rem;
    }
    .topic-picker > summary::-webkit-details-marker { display: none; }
    .topic-picker > summary span { flex: none; color: var(--muted); }
    .topic-picker > summary strong { color: var(--accent); overflow-wrap: anywhere; }
    .topic-picker > summary :global(svg) { flex: none; margin-inline-start: auto; }
    .topic-picker[open] > summary :global(svg) { rotate: 180deg; }
    .topic-picker nav { display: grid; padding-block-end: 10px; }
    .topic-picker nav a { display: flex; align-items: center; min-height: 44px; padding: 5px 9px; border-top: 1px solid var(--edge); font-size: .9rem; text-decoration: none; }
    .topic-picker nav a[aria-current] { background: var(--bg); color: var(--accent); box-shadow: inset 3px 0 var(--brand-green); font-weight: 620; }
    .topic-picker nav a:hover { color: var(--accent); }
  }
  @media (max-width: 575px) {
    .example-grid, .topic-theory ul { grid-template-columns: minmax(0, 1fr); }
    .example-copy { padding-inline: 14px; }
  }
</style>
