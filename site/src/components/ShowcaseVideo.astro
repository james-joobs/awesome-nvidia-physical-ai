---
import { showcaseCopy, showcaseMedia } from '../lib/showcase.mjs';

const { locale, clip, title, eager = false, autoplay = false } = Astro.props;
const labels = showcaseCopy[locale];
const mediaId = clip.media?.[locale] ?? clip.id;
const poster = showcaseMedia(`${mediaId}.jpg`);
const movie = showcaseMedia(`${mediaId}.mp4`);
const playLabel = locale === 'ko' ? `${title} ${labels.play}` : `${labels.play} ${title}`;
---
<div class="video-frame" style={{aspectRatio: `${clip.width} / ${clip.height}`}}>
  <a href={movie} class="video-cover" data-video-cover data-autoplay={autoplay ? '' : undefined} aria-label={playLabel}>
    <img src={poster} width={clip.width} height={clip.height} loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'} alt="" />
    <span class="video-play" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 4.75v14.5L20 12z" /></svg>
    </span>
    <span class="video-duration" aria-hidden="true">{clip.duration}</span>
  </a>
  <video hidden controls playsinline muted={autoplay} preload="none" tabindex="0" aria-label={title} poster={poster}></video>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  for (const cover of document.querySelectorAll<HTMLAnchorElement>('[data-video-cover]')) {
    const player = cover.nextElementSibling;
    if (!(player instanceof HTMLVideoElement)) continue;
    const play = () => {
      if (!player.hasAttribute('src')) player.src = cover.href;
      cover.hidden = true;
      player.hidden = false;
      return player.play();
    };
    cover.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      void play().catch(() => {});
      player.focus();
    });
    if (cover.hasAttribute('data-autoplay') && !reduceMotion.matches) {
      player.muted = true;
      void play().catch(() => {
        player.hidden = true;
        cover.hidden = false;
      });
    }
  }
</script>

<style>
  .video-frame {
    background: var(--media-bg);
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: clip;
  }
  .video-frame > [hidden] { display: none; }
  .video-cover, video { display: block; width: 100%; height: 100%; }
  .video-cover { position: relative; }
  .video-cover:focus-visible { outline-offset: -4px; }
  .video-cover img { width: 100%; height: 100%; object-fit: contain; }
  .video-play {
    position: absolute; top: 50%; left: 50%; translate: -50% -50%;
    display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%;
    color: var(--ink); background: var(--accent-fill);
    box-shadow: 0 0 0 4px #121a125c, 0 4px 20px #0009;
    transition: background-color 120ms ease, scale 120ms ease;
  }
  .video-cover:is(:hover, :focus-visible) .video-play { background: var(--accent-fill-hover); scale: 1.06; }
  .video-duration {
    position: absolute; right: 10px; bottom: 10px;
    padding: 3px 7px; border-radius: 4px;
    color: #fff; background: var(--media-overlay);
    font-size: .78rem; font-variant-numeric: tabular-nums;
  }
  @media (prefers-reduced-motion: reduce) {
    .video-play { transition: none; }
  }
</style>
